option(ROSETTA_BUILD_TCL_EXAMPLES "Build and test Tcl extensions (requires Tcl 9.0+ headers and stub library)" OFF)
if(ROSETTA_BUILD_TCL_EXAMPLES)
    find_program(ROSETTA_TCLSH_EXECUTABLE NAMES tclsh9.0 tclsh REQUIRED)
    execute_process(COMMAND "${ROSETTA_TCLSH_EXECUTABLE}"
        INPUT_FILE "${CMAKE_CURRENT_SOURCE_DIR}/cmake/tcl_config.tcl"
        OUTPUT_VARIABLE tcl_config OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" tcl_config "${tcl_config}")
    list(GET tcl_config 0 tcl_VERSION)
    list(GET tcl_config 1 tcl_extension)
    list(GET tcl_config 2 tcl_prefix)
    if(tcl_VERSION VERSION_LESS 9.0)
        message(FATAL_ERROR "Tcl examples require Tcl 9.0 or newer; ${ROSETTA_TCLSH_EXECUTABLE} is ${tcl_VERSION}")
    endif()
    find_path(ROSETTA_TCL_INCLUDE_DIR tcl.h HINTS "${tcl_prefix}/include" PATH_SUFFIXES tcl9.0 tcl9 REQUIRED NO_DEFAULT_PATH)
    find_library(ROSETTA_TCL_STUB_LIBRARY NAMES tclstub tclstub9.0 HINTS "${tcl_prefix}/lib" REQUIRED NO_DEFAULT_PATH)
    find_package(Threads REQUIRED)
    set(tcl_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/tcl")
    set(tcl_index "")
    set(tcl_modules demo verify)
    if(BUILD_TESTING)
        list(APPEND tcl_modules names)
    endif()
    foreach(example ${tcl_modules})
        if(example STREQUAL "demo")
            set(header "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_demo.hpp")
            set(policy POLICY "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_demo.policy.json")
        elseif(example STREQUAL "verify")
            set(header "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_verification.hpp")
            set(policy POLICY "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_verification.policy.json")
        else()
            set(header "${CMAKE_CURRENT_SOURCE_DIR}/tests/tcl_names.hpp")
            set(policy)
        endif()
        rosetta_generate_tcl(HEADER "${header}" MODULE tcl_${example} OUTPUT "${tcl_generated}/${example}.cpp"
            CLANG "${ROSETTA_CLANG_EXECUTABLE}" ${policy})
        add_library(rosetta_tcl_${example} MODULE "${tcl_generated}/${example}.cpp")
        set_target_properties(rosetta_tcl_${example} PROPERTIES PREFIX "" OUTPUT_NAME tcl_${example} SUFFIX "${tcl_extension}")
        target_compile_definitions(rosetta_tcl_${example} PRIVATE USE_TCL_STUBS)
        target_include_directories(rosetta_tcl_${example} SYSTEM PRIVATE "${ROSETTA_TCL_INCLUDE_DIR}")
        target_link_libraries(rosetta_tcl_${example} PRIVATE "${ROSETTA_TCL_STUB_LIBRARY}")
        target_compile_features(rosetta_tcl_${example} PRIVATE cxx_std_17)
        rosetta_warnings(rosetta_tcl_${example})
        string(APPEND tcl_index "package ifneeded tcl_${example} 1.0 [list load [file join $dir tcl_${example}${tcl_extension}] Tcl_${example}]\n")
    endforeach()
    target_sources(rosetta_tcl_verify PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_verification.cpp")
    target_compile_features(rosetta_tcl_verify PRIVATE cxx_std_20)
    target_link_libraries(rosetta_tcl_verify PRIVATE Threads::Threads)
    # `package require tcl_demo` finds the build directory through auto_path or TCLLIBPATH.
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/pkgIndex.tcl" "${tcl_index}")
    add_custom_target(tcl-repl
        COMMAND "${CMAKE_COMMAND}" -E env "TCLLIBPATH=${CMAKE_CURRENT_BINARY_DIR}"
            "${ROSETTA_TCLSH_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/examples/repl.tcl"
        DEPENDS rosetta_tcl_demo rosetta_tcl_verify USES_TERMINAL VERBATIM)
    if(BUILD_TESTING)
        foreach(family scalars objects features repl)
            add_test(NAME tcl_${family} COMMAND "${CMAKE_COMMAND}" -E env "TCLLIBPATH=${CMAKE_CURRENT_BINARY_DIR}"
                "${ROSETTA_TCLSH_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_tcl.tcl" ${family}
                "${CMAKE_CURRENT_SOURCE_DIR}/examples/repl.tcl")
            set_tests_properties(tcl_${family} PROPERTIES TIMEOUT 45)
        endforeach()
    endif()
endif()
