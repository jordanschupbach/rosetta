include_guard(GLOBAL)

# Generate sources only; the caller owns its module target/runtime linkage.
function(rosetta_generate_lua)
    _rosetta_generate(lua)
endfunction()

function(rosetta_generate_r)
    _rosetta_generate(r)
endfunction()

function(rosetta_generate_python)
    _rosetta_generate(python)
endfunction()

function(rosetta_generate_ruby)
    _rosetta_generate(ruby)
endfunction()

function(rosetta_generate_octave)
    _rosetta_generate(octave)
endfunction()

function(rosetta_generate_julia)
    _rosetta_generate(julia)
endfunction()

function(rosetta_generate_java)
    _rosetta_generate(java)
endfunction()

function(rosetta_generate_fortran)
    _rosetta_generate(fortran)
endfunction()

function(rosetta_generate_csharp)
    _rosetta_generate(csharp)
endfunction()

function(rosetta_generate_common_lisp)
    _rosetta_generate(common-lisp)
endfunction()

function(rosetta_generate_tcl)
    _rosetta_generate(tcl)
endfunction()

function(rosetta_generate_guile)
    _rosetta_generate(guile)
endfunction()

function(rosetta_generate_ocaml)
    _rosetta_generate(ocaml)
endfunction()

function(rosetta_generate_go)
    _rosetta_generate(go)
endfunction()

# GNU_APL_OUTPUT and DYALOG_OUTPUT default to MODULE.apl and MODULE.apln beside
# OUTPUT; APL_LIBRARY_DIR is where both load their libraries from.
function(rosetta_generate_apl)
    _rosetta_generate(apl)
endfunction()

# COBOL_OUTPUT (the copybook) defaults to MODULE.cpy beside OUTPUT;
# COBOL_STRING_SIZE sets the capacity of string fields.
function(rosetta_generate_cobol)
    _rosetta_generate(cobol)
endfunction()

# Parse the enclosing public function's arguments directly, preserving literal
# semicolons in paths/flags rather than expanding ARGV through another call.
macro(_rosetta_generate language)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "HEADER;MODULE;OUTPUT;IR;DEPFILE;POLICY;CLANG;EXECUTABLE;COMPILE_COMMANDS;TRANSLATION_UNIT;COMMAND_INDEX;R_OUTPUT;OBJECT_SYSTEM;JULIA_OUTPUT;JAVA_OUTPUT;JAVA_PACKAGE;CSHARP_OUTPUT;CSHARP_NAMESPACE;FORTRAN_OUTPUT;LISP_OUTPUT;GUILE_OUTPUT;OCAML_OUTPUT;GO_OUTPUT;GNU_APL_OUTPUT;DYALOG_OUTPUT;APL_LIBRARY_DIR;COBOL_OUTPUT;COBOL_STRING_SIZE" "FLAGS")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid rosetta_generate_${language} arguments")
    endif()
    foreach(required HEADER MODULE OUTPUT)
        if(NOT DEFINED ARG_${required} OR "${ARG_${required}}" STREQUAL "")
            message(FATAL_ERROR "rosetta_generate_${language} requires ${required}")
        endif()
    endforeach()
    get_filename_component(header "${ARG_HEADER}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(output "${ARG_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    if(NOT DEFINED ARG_DEPFILE)
        set(ARG_DEPFILE "${output}.d")
    endif()
    get_filename_component(depfile "${ARG_DEPFILE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    if(NOT DEFINED ARG_EXECUTABLE)
        if(TARGET rosetta)
            set(ARG_EXECUTABLE rosetta)
        else()
            find_program(ROSETTA_EXECUTABLE NAMES rosetta REQUIRED)
            set(ARG_EXECUTABLE "${ROSETTA_EXECUTABLE}")
        endif()
    endif()
    if(NOT DEFINED ARG_CLANG)
        find_program(ROSETTA_CLANG_EXECUTABLE NAMES clang++ REQUIRED)
        set(ARG_CLANG "${ROSETTA_CLANG_EXECUTABLE}")
    endif()
    set(outputs "${output}")
    set(depends "${ARG_EXECUTABLE}" "${header}")
    set(command "${ARG_EXECUTABLE}" "${header}" --language "${language}" --module "${ARG_MODULE}" --clang "${ARG_CLANG}"
        -o "${output}" --depfile "${depfile}")
    if("${language}" STREQUAL "r")
        if(NOT DEFINED ARG_R_OUTPUT)
            get_filename_component(r_dir "${output}" DIRECTORY)
            get_filename_component(r_stem "${output}" NAME_WLE)
            set(ARG_R_OUTPUT "${r_dir}/${r_stem}.R")
        endif()
        if(NOT DEFINED ARG_OBJECT_SYSTEM)
            set(ARG_OBJECT_SYSTEM r6)
        endif()
        get_filename_component(r_output "${ARG_R_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${r_output}")
        list(APPEND command --r-output "${r_output}" --object-system "${ARG_OBJECT_SYSTEM}")
    elseif(DEFINED ARG_R_OUTPUT OR DEFINED ARG_OBJECT_SYSTEM)
        message(FATAL_ERROR "R_OUTPUT and OBJECT_SYSTEM require rosetta_generate_r")
    endif()
    if("${language}" STREQUAL "julia")
        if(NOT DEFINED ARG_JULIA_OUTPUT)
            get_filename_component(julia_dir "${output}" DIRECTORY)
            get_filename_component(julia_stem "${output}" NAME_WLE)
            set(ARG_JULIA_OUTPUT "${julia_dir}/${julia_stem}.jl")
        endif()
        get_filename_component(julia_output "${ARG_JULIA_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${julia_output}")
        list(APPEND command --julia-output "${julia_output}")
    elseif(DEFINED ARG_JULIA_OUTPUT)
        message(FATAL_ERROR "JULIA_OUTPUT requires rosetta_generate_julia")
    endif()
    if("${language}" STREQUAL "common-lisp")
        if(NOT DEFINED ARG_LISP_OUTPUT)
            get_filename_component(lisp_dir "${output}" DIRECTORY)
            get_filename_component(lisp_stem "${output}" NAME_WLE)
            set(ARG_LISP_OUTPUT "${lisp_dir}/${lisp_stem}.lisp")
        endif()
        get_filename_component(lisp_output "${ARG_LISP_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${lisp_output}")
        list(APPEND command --lisp-output "${lisp_output}")
    elseif(DEFINED ARG_LISP_OUTPUT)
        message(FATAL_ERROR "LISP_OUTPUT requires rosetta_generate_common_lisp")
    endif()
    if("${language}" STREQUAL "guile")
        if(NOT DEFINED ARG_GUILE_OUTPUT)
            get_filename_component(guile_dir "${output}" DIRECTORY)
            set(ARG_GUILE_OUTPUT "${guile_dir}/${ARG_MODULE}.scm")
        endif()
        get_filename_component(guile_output "${ARG_GUILE_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${guile_output}")
        list(APPEND command --guile-output "${guile_output}")
    elseif(DEFINED ARG_GUILE_OUTPUT)
        message(FATAL_ERROR "GUILE_OUTPUT requires rosetta_generate_guile")
    endif()
    if("${language}" STREQUAL "ocaml")
        if(NOT DEFINED ARG_OCAML_OUTPUT)
            get_filename_component(ocaml_dir "${output}" DIRECTORY)
            set(ARG_OCAML_OUTPUT "${ocaml_dir}/${ARG_MODULE}.ml")
        endif()
        get_filename_component(ocaml_output "${ARG_OCAML_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${ocaml_output}")
        list(APPEND command --ocaml-output "${ocaml_output}")
    elseif(DEFINED ARG_OCAML_OUTPUT)
        message(FATAL_ERROR "OCAML_OUTPUT requires rosetta_generate_ocaml")
    endif()
    if("${language}" STREQUAL "go")
        if(NOT DEFINED ARG_GO_OUTPUT)
            get_filename_component(go_dir "${output}" DIRECTORY)
            set(ARG_GO_OUTPUT "${go_dir}/${ARG_MODULE}.go")
        endif()
        get_filename_component(go_output "${ARG_GO_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${go_output}")
        list(APPEND command --go-output "${go_output}")
    elseif(DEFINED ARG_GO_OUTPUT)
        message(FATAL_ERROR "GO_OUTPUT requires rosetta_generate_go")
    endif()
    if("${language}" STREQUAL "apl")
        get_filename_component(apl_dir "${output}" DIRECTORY)
        if(NOT DEFINED ARG_GNU_APL_OUTPUT)
            set(ARG_GNU_APL_OUTPUT "${apl_dir}/${ARG_MODULE}.apl")
        endif()
        if(NOT DEFINED ARG_DYALOG_OUTPUT)
            set(ARG_DYALOG_OUTPUT "${apl_dir}/${ARG_MODULE}.apln")
        endif()
        get_filename_component(gnu_apl_output "${ARG_GNU_APL_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        get_filename_component(dyalog_output "${ARG_DYALOG_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${gnu_apl_output}" "${dyalog_output}")
        list(APPEND command --gnu-apl-output "${gnu_apl_output}" --dyalog-output "${dyalog_output}")
        if(DEFINED ARG_APL_LIBRARY_DIR)
            list(APPEND command --apl-library-dir "${ARG_APL_LIBRARY_DIR}")
        endif()
    elseif(DEFINED ARG_GNU_APL_OUTPUT OR DEFINED ARG_DYALOG_OUTPUT OR DEFINED ARG_APL_LIBRARY_DIR)
        message(FATAL_ERROR "GNU_APL_OUTPUT, DYALOG_OUTPUT and APL_LIBRARY_DIR require rosetta_generate_apl")
    endif()
    if("${language}" STREQUAL "cobol")
        if(NOT DEFINED ARG_COBOL_OUTPUT)
            get_filename_component(cobol_dir "${output}" DIRECTORY)
            set(ARG_COBOL_OUTPUT "${cobol_dir}/${ARG_MODULE}.cpy")
        endif()
        get_filename_component(cobol_output "${ARG_COBOL_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${cobol_output}")
        list(APPEND command --cobol-output "${cobol_output}")
        if(DEFINED ARG_COBOL_STRING_SIZE)
            list(APPEND command --cobol-string-size "${ARG_COBOL_STRING_SIZE}")
        endif()
    elseif(DEFINED ARG_COBOL_OUTPUT OR DEFINED ARG_COBOL_STRING_SIZE)
        message(FATAL_ERROR "COBOL_OUTPUT and COBOL_STRING_SIZE require rosetta_generate_cobol")
    endif()
    if("${language}" STREQUAL "java")
        if(NOT DEFINED ARG_JAVA_OUTPUT)
            get_filename_component(java_dir "${output}" DIRECTORY)
            set(ARG_JAVA_OUTPUT "${java_dir}/${ARG_MODULE}.java")
        endif()
        get_filename_component(java_output "${ARG_JAVA_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${java_output}")
        list(APPEND command --java-output "${java_output}")
        if(DEFINED ARG_JAVA_PACKAGE)
            list(APPEND command --java-package "${ARG_JAVA_PACKAGE}")
        endif()
    elseif(DEFINED ARG_JAVA_OUTPUT OR DEFINED ARG_JAVA_PACKAGE)
        message(FATAL_ERROR "JAVA_OUTPUT and JAVA_PACKAGE require rosetta_generate_java")
    endif()
    if("${language}" STREQUAL "csharp")
        if(NOT DEFINED ARG_CSHARP_OUTPUT)
            get_filename_component(csharp_dir "${output}" DIRECTORY)
            set(ARG_CSHARP_OUTPUT "${csharp_dir}/${ARG_MODULE}.cs")
        endif()
        get_filename_component(csharp_output "${ARG_CSHARP_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${csharp_output}")
        list(APPEND command --csharp-output "${csharp_output}")
        if(DEFINED ARG_CSHARP_NAMESPACE)
            list(APPEND command --csharp-namespace "${ARG_CSHARP_NAMESPACE}")
        endif()
    elseif(DEFINED ARG_CSHARP_OUTPUT OR DEFINED ARG_CSHARP_NAMESPACE)
        message(FATAL_ERROR "CSHARP_OUTPUT and CSHARP_NAMESPACE require rosetta_generate_csharp")
    endif()
    if("${language}" STREQUAL "fortran")
        if(NOT DEFINED ARG_FORTRAN_OUTPUT)
            get_filename_component(fortran_dir "${output}" DIRECTORY)
            set(ARG_FORTRAN_OUTPUT "${fortran_dir}/${ARG_MODULE}.f90")
        endif()
        get_filename_component(fortran_output "${ARG_FORTRAN_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${fortran_output}")
        list(APPEND command --fortran-output "${fortran_output}")
    elseif(DEFINED ARG_FORTRAN_OUTPUT)
        message(FATAL_ERROR "FORTRAN_OUTPUT requires rosetta_generate_fortran")
    endif()
    if(IS_ABSOLUTE "${ARG_CLANG}")
        list(APPEND depends "${ARG_CLANG}")
    endif()
    if(DEFINED ARG_IR)
        get_filename_component(ir "${ARG_IR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${ir}")
        list(APPEND command --dump-ir "${ir}")
    endif()
    if(DEFINED ARG_POLICY)
        get_filename_component(policy "${ARG_POLICY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND command --policy "${policy}")
        list(APPEND depends "${policy}")
    endif()
    if(DEFINED ARG_COMPILE_COMMANDS)
        get_filename_component(database "${ARG_COMPILE_COMMANDS}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        if(IS_DIRECTORY "${database}")
            set(database "${database}/compile_commands.json")
        endif()
        list(APPEND command --compile-commands "${database}")
        list(APPEND depends "${database}")
    elseif(DEFINED ARG_TRANSLATION_UNIT OR DEFINED ARG_COMMAND_INDEX)
        message(FATAL_ERROR "Translation-unit/command selection requires COMPILE_COMMANDS")
    endif()
    if(DEFINED ARG_TRANSLATION_UNIT)
        get_filename_component(unit "${ARG_TRANSLATION_UNIT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND command --translation-unit "${unit}")
        list(APPEND depends "${unit}")
    endif()
    if(DEFINED ARG_COMMAND_INDEX)
        list(APPEND command --command-index "${ARG_COMMAND_INDEX}")
    endif()

    # Some CMake versions decode #/$ but fail to re-escape them when rewriting
    # Ninja depfiles. Probe the installed consumer, not a guessed version range.
    # Rosetta emits absolute paths, so direct consumption is safe when needed.
    if(CMAKE_GENERATOR MATCHES "^Ninja")
        set(probe_dir "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/rosetta-depfile-probe")
        file(MAKE_DIRECTORY "${probe_dir}")
        file(WRITE "${probe_dir}/in.d" "probe: name\\ \\#$$.hpp\n")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E cmake_transform_depfile "${CMAKE_GENERATOR}" gccdepfile
            "${CMAKE_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_BINARY_DIR}" "${CMAKE_CURRENT_BINARY_DIR}"
            "${probe_dir}/in.d" "${probe_dir}/out.d" RESULT_VARIABLE probe_status ERROR_QUIET)
        if(NOT probe_status EQUAL 0)
            message(FATAL_ERROR "Cannot validate CMake's Ninja depfile transformation")
        endif()
        file(READ "${probe_dir}/out.d" transformed)
        string(FIND "${transformed}" "name\\ \\#$$.hpp" escaped_name)
        if(escaped_name EQUAL -1)
            # Local compatibility setting; callers retain their own policies.
            set(CMAKE_WARN_DEPRECATED FALSE)
            cmake_policy(SET CMP0116 OLD)
        endif()
    endif()
    if("${language}" STREQUAL "r")
        set(language_label "R")
    elseif("${language}" STREQUAL "python")
        set(language_label "Python")
    elseif("${language}" STREQUAL "ruby")
        set(language_label "Ruby")
    elseif("${language}" STREQUAL "octave")
        set(language_label "Octave")
    elseif("${language}" STREQUAL "julia")
        set(language_label "Julia")
    elseif("${language}" STREQUAL "java")
        set(language_label "Java")
    elseif("${language}" STREQUAL "csharp")
        set(language_label "C#")
    elseif("${language}" STREQUAL "fortran")
        set(language_label "Fortran")
    elseif("${language}" STREQUAL "common-lisp")
        set(language_label "Common Lisp")
    elseif("${language}" STREQUAL "tcl")
        set(language_label "Tcl")
    elseif("${language}" STREQUAL "guile")
        set(language_label "Guile")
    elseif("${language}" STREQUAL "ocaml")
        set(language_label "OCaml")
    elseif("${language}" STREQUAL "go")
        set(language_label "Go")
    elseif("${language}" STREQUAL "apl")
        set(language_label "APL")
    elseif("${language}" STREQUAL "cobol")
        set(language_label "COBOL")
    else()
        set(language_label "Lua")
    endif()
    add_custom_command(OUTPUT ${outputs}
        COMMAND ${command} -- ${ARG_FLAGS}
        DEPENDS ${depends}
        DEPFILE "${depfile}"
        VERBATIM COMMENT "Generating ${language_label} bindings: ${ARG_MODULE}")
endmacro()
