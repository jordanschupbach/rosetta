            get_filename_component(ARG_ADA_OUTPUT "${output}" DIRECTORY)
        endif()
        get_filename_component(ada_output "${ARG_ADA_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        if(DEFINED ARG_ADA_PACKAGE)
            set(ada_file "${ARG_ADA_PACKAGE}")
        else()
            # MODULE's snake_case words, as rosetta names it (camelCase and PascalCase words split).
            string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" ada_file "${ARG_MODULE}")
            string(REGEX REPLACE "([A-Z])([A-Z][a-z])" "\\1_\\2" ada_file "${ada_file}")
        endif()
        string(TOLOWER "${ada_file}" ada_file)
        list(APPEND outputs "${ada_output}/${ada_file}.ads" "${ada_output}/${ada_file}.adb" "${ada_output}/${ada_file}.gpr")
        list(APPEND command --ada-output "${ada_output}")
        foreach(option PACKAGE LIBRARY)
            if(DEFINED ARG_ADA_${option})
                string(TOLOWER "${option}" flag)
                list(APPEND command --ada-${flag} "${ARG_ADA_${option}}")
            endif()
        endforeach()
    elseif(DEFINED ARG_ADA_OUTPUT OR DEFINED ARG_ADA_PACKAGE OR DEFINED ARG_ADA_LIBRARY)
        message(FATAL_ERROR "ADA_OUTPUT, ADA_PACKAGE and ADA_LIBRARY require rosetta_generate_ada")
    endif()
    if("${language}" STREQUAL "objective-c")
        if(NOT DEFINED ARG_OBJC_OUTPUT)
            get_filename_component(ARG_OBJC_OUTPUT "${output}" DIRECTORY)
        endif()
        get_filename_component(objc_output "${ARG_OBJC_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        if(DEFINED ARG_OBJC_PREFIX)
            set(objc_prefix "${ARG_OBJC_PREFIX}")
        else()
            # MODULE in PascalCase, as rosetta names it (its snake_case words capitalized).
            string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" objc_words "${ARG_MODULE}")
            string(REGEX REPLACE "([A-Z])([A-Z][a-z])" "\\1_\\2" objc_words "${objc_words}")
            string(TOLOWER "${objc_words}" objc_words)
            string(REPLACE "_" ";" objc_words "${objc_words}")
            set(objc_prefix "")
            foreach(word IN LISTS objc_words)
                if(NOT "${word}" STREQUAL "")
                    string(SUBSTRING "${word}" 0 1 first)
                    string(SUBSTRING "${word}" 1 -1 rest)
                    string(TOUPPER "${first}" first)
                    string(APPEND objc_prefix "${first}${rest}")
                endif()
            endforeach()
        endif()
        list(APPEND outputs "${objc_output}/${objc_prefix}.h" "${objc_output}/${objc_prefix}.m")
        list(APPEND command --objc-output "${objc_output}")
        foreach(option PREFIX LIBRARY)
            if(DEFINED ARG_OBJC_${option})
                string(TOLOWER "${option}" flag)
                list(APPEND command --objc-${flag} "${ARG_OBJC_${option}}")
            endif()
        endforeach()
    elseif(DEFINED ARG_OBJC_OUTPUT OR DEFINED ARG_OBJC_PREFIX OR DEFINED ARG_OBJC_LIBRARY)
        message(FATAL_ERROR "OBJC_OUTPUT, OBJC_PREFIX and OBJC_LIBRARY require rosetta_generate_objc")
    endif()
    if("${language}" STREQUAL "fortran")
        if(NOT DEFINED ARG_FORTRAN_OUTPUT)
            get_filename_component(fortran_dir "${output}" DIRECTORY)
            set(ARG_FORTRAN_OUTPUT "${fortran_dir}/${ARG_MODULE}.f90")
        endif()
        get_filename_component(fortran_output "${ARG_FORTRAN_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${fortran_output}")
        list(APPEND command --fortran-output "${fortran_output}")
        # FORTRAN_API full: derived types, generic interfaces, containers, callbacks and FORD docs
        # over the shared C ABI library; FORTRAN_MODULE names the Fortran module.
        if(DEFINED ARG_FORTRAN_API)
            list(APPEND command --fortran-api "${ARG_FORTRAN_API}")
        endif()
        if("${ARG_FORTRAN_API}" STREQUAL "full")
            if(DEFINED ARG_FORTRAN_MODULE)
                list(APPEND command --fortran-module "${ARG_FORTRAN_MODULE}")
            endif()
        elseif(DEFINED ARG_FORTRAN_MODULE)
            message(FATAL_ERROR "FORTRAN_MODULE requires FORTRAN_API full")
        endif()
    elseif(DEFINED ARG_FORTRAN_OUTPUT OR DEFINED ARG_FORTRAN_API OR DEFINED ARG_FORTRAN_MODULE)
        message(FATAL_ERROR "FORTRAN_OUTPUT, FORTRAN_API and FORTRAN_MODULE require rosetta_generate_fortran")
    endif()
    # RUBY_API full: an MRI native extension plus a YARD-documented Ruby file (RUBY_OUTPUT, default
    # MODULE.rb beside OUTPUT) that require_relative's the extension at RUBY_NATIVE (default
    # MODULE/MODULE); RUBY_MODULE names the Ruby module (default: MODULE in CamelCase).
    if("${language}" STREQUAL "ruby" AND DEFINED ARG_RUBY_API)
        list(APPEND command --ruby-api "${ARG_RUBY_API}")
        if("${ARG_RUBY_API}" STREQUAL "full")
            if(NOT DEFINED ARG_RUBY_OUTPUT)
                get_filename_component(ruby_dir "${output}" DIRECTORY)
                set(ARG_RUBY_OUTPUT "${ruby_dir}/${ARG_MODULE}.rb")
            endif()
            get_filename_component(ruby_output "${ARG_RUBY_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
            list(APPEND outputs "${ruby_output}")
            list(APPEND command --ruby-output "${ruby_output}")
            if(DEFINED ARG_RUBY_MODULE)
                list(APPEND command --ruby-module "${ARG_RUBY_MODULE}")
            endif()
            if(DEFINED ARG_RUBY_NATIVE)
                list(APPEND command --ruby-native "${ARG_RUBY_NATIVE}")
            endif()
        elseif(DEFINED ARG_RUBY_MODULE OR DEFINED ARG_RUBY_OUTPUT OR DEFINED ARG_RUBY_NATIVE)
            message(FATAL_ERROR "RUBY_MODULE, RUBY_OUTPUT and RUBY_NATIVE require RUBY_API full")
        endif()
    elseif(DEFINED ARG_RUBY_API OR DEFINED ARG_RUBY_MODULE OR DEFINED ARG_RUBY_OUTPUT OR DEFINED ARG_RUBY_NATIVE)
        message(FATAL_ERROR "RUBY_API, RUBY_MODULE, RUBY_OUTPUT and RUBY_NATIVE require rosetta_generate_ruby with RUBY_API")
    endif()
    # OCTAVE_API full: OUTPUT (plus PARTS) is the source of the oct-file __MODULE__.oct; the package
    # +OCTAVE_PACKAGE (default MODULE) of .m files goes in OCTAVE_OUTPUT (default: OUTPUT's directory).
    # +PACKAGE/Contents.m is the declared output; the other .m files are written with it.
    if("${language}" STREQUAL "octave" AND DEFINED ARG_OCTAVE_API)
        list(APPEND command --octave-api "${ARG_OCTAVE_API}")
        if("${ARG_OCTAVE_API}" STREQUAL "full")
            if(NOT DEFINED ARG_OCTAVE_OUTPUT)
                get_filename_component(ARG_OCTAVE_OUTPUT "${output}" DIRECTORY)
            endif()
            if(NOT DEFINED ARG_OCTAVE_PACKAGE)
                set(ARG_OCTAVE_PACKAGE "${ARG_MODULE}")
            endif()
            get_filename_component(octave_output "${ARG_OCTAVE_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
            list(APPEND outputs "${octave_output}/+${ARG_OCTAVE_PACKAGE}/Contents.m")
            list(APPEND command --octave-output "${octave_output}" --octave-package "${ARG_OCTAVE_PACKAGE}")
        elseif(DEFINED ARG_OCTAVE_OUTPUT OR DEFINED ARG_OCTAVE_PACKAGE)
            message(FATAL_ERROR "OCTAVE_OUTPUT and OCTAVE_PACKAGE require OCTAVE_API full")
        endif()
    elseif(DEFINED ARG_OCTAVE_API OR DEFINED ARG_OCTAVE_OUTPUT OR DEFINED ARG_OCTAVE_PACKAGE)
        message(FATAL_ERROR "OCTAVE_API, OCTAVE_OUTPUT and OCTAVE_PACKAGE require rosetta_generate_octave with OCTAVE_API")
    endif()
    # TCL_API full: OUTPUT (plus PARTS) is the source of a stubs-enabled Tcl extension; TCL_OUTPUT
    # (default MODULE.tcl beside OUTPUT) is the documented package file that loads it, and
    # TCL_PKGINDEX (default pkgIndex.tcl beside TCL_OUTPUT) its package index. TCL_NAMESPACE
    # (default MODULE), TCL_LIBRARY (the shared library basename, default MODULE) and TCL_VERSION
    # (default 1.0) are optional.
    if("${language}" STREQUAL "tcl" AND DEFINED ARG_TCL_API)
        list(APPEND command --tcl-api "${ARG_TCL_API}")
        if("${ARG_TCL_API}" STREQUAL "full")
            if(NOT DEFINED ARG_TCL_OUTPUT)
                get_filename_component(tcl_dir "${output}" DIRECTORY)
                set(ARG_TCL_OUTPUT "${tcl_dir}/${ARG_MODULE}.tcl")
            endif()
            get_filename_component(tcl_output "${ARG_TCL_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
            if(NOT DEFINED ARG_TCL_PKGINDEX)
                get_filename_component(tcl_dir "${tcl_output}" DIRECTORY)
                set(ARG_TCL_PKGINDEX "${tcl_dir}/pkgIndex.tcl")
            endif()
            get_filename_component(tcl_pkgindex "${ARG_TCL_PKGINDEX}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
            list(APPEND outputs "${tcl_output}" "${tcl_pkgindex}")
            list(APPEND command --tcl-output "${tcl_output}" --tcl-pkgindex "${tcl_pkgindex}")
            foreach(option NAMESPACE LIBRARY VERSION)
                if(DEFINED ARG_TCL_${option})
                    string(TOLOWER "${option}" option_name)
                    list(APPEND command --tcl-${option_name} "${ARG_TCL_${option}}")
                endif()
            endforeach()
        elseif(DEFINED ARG_TCL_OUTPUT OR DEFINED ARG_TCL_PKGINDEX OR DEFINED ARG_TCL_NAMESPACE OR DEFINED ARG_TCL_LIBRARY OR DEFINED ARG_TCL_VERSION)
            message(FATAL_ERROR "TCL_OUTPUT, TCL_PKGINDEX, TCL_NAMESPACE, TCL_LIBRARY and TCL_VERSION require TCL_API full")
        endif()
    elseif(DEFINED ARG_TCL_API OR DEFINED ARG_TCL_OUTPUT OR DEFINED ARG_TCL_PKGINDEX OR DEFINED ARG_TCL_NAMESPACE OR DEFINED ARG_TCL_LIBRARY OR DEFINED ARG_TCL_VERSION)
        message(FATAL_ERROR "TCL_API, TCL_OUTPUT, TCL_PKGINDEX, TCL_NAMESPACE, TCL_LIBRARY and TCL_VERSION require rosetta_generate_tcl with TCL_API")
    endif()
    if(IS_ABSOLUTE "${ARG_CLANG}")
        list(APPEND depends "${ARG_CLANG}")
    endif()
    if(DEFINED ARG_IR)
        get_filename_component(ir "${ARG_IR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${ir}")
        list(APPEND command --dump-ir "${ir}")
    endif()
    if(DEFINED ARG_POLICY)
        get_filename_component(policy "${ARG_POLICY}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND command --policy "${policy}")
        list(APPEND depends "${policy}")
    endif()
    if(DEFINED ARG_COMPILE_COMMANDS)
        get_filename_component(database "${ARG_COMPILE_COMMANDS}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        if(IS_DIRECTORY "${database}")
            set(database "${database}/compile_commands.json")
        endif()
        list(APPEND command --compile-commands "${database}")
        list(APPEND depends "${database}")
    elseif(DEFINED ARG_TRANSLATION_UNIT OR DEFINED ARG_COMMAND_INDEX)
        message(FATAL_ERROR "Translation-unit/command selection requires COMPILE_COMMANDS")
    endif()
    if(DEFINED ARG_TRANSLATION_UNIT)
        get_filename_component(unit "${ARG_TRANSLATION_UNIT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        list(APPEND command --translation-unit "${unit}")
        list(APPEND depends "${unit}")
    endif()
    if(DEFINED ARG_COMMAND_INDEX)
        list(APPEND command --command-index "${ARG_COMMAND_INDEX}")
    endif()

    # Some CMake versions decode #/$ but fail to re-escape them when rewriting
    # Ninja depfiles. Probe the installed consumer, not a guessed version range.
    # Rosetta emits absolute paths, so direct consumption is safe when needed.
    if(CMAKE_GENERATOR MATCHES "^Ninja")
        set(probe_dir "${CMAKE_CURRENT_BINARY_DIR}/CMakeFiles/rosetta-depfile-probe")
        file(MAKE_DIRECTORY "${probe_dir}")
        file(WRITE "${probe_dir}/in.d" "probe: name\\ \\#$$.hpp\n")
        execute_process(COMMAND "${CMAKE_COMMAND}" -E cmake_transform_depfile "${CMAKE_GENERATOR}" gccdepfile
            "${CMAKE_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_BINARY_DIR}" "${CMAKE_CURRENT_BINARY_DIR}"
            "${probe_dir}/in.d" "${probe_dir}/out.d" RESULT_VARIABLE probe_status ERROR_QUIET)
        if(NOT probe_status EQUAL 0)
            message(FATAL_ERROR "Cannot validate CMake's Ninja depfile transformation")
        endif()
        file(READ "${probe_dir}/out.d" transformed)
        string(FIND "${transformed}" "name\\ \\#$$.hpp" escaped_name)
        if(escaped_name EQUAL -1)
            # Local compatibility setting; callers retain their own policies.
            set(CMAKE_WARN_DEPRECATED FALSE)
            cmake_policy(SET CMP0116 OLD)
        endif()
    endif()
    if("${language}" STREQUAL "r")
        set(language_label "R")
    elseif("${language}" STREQUAL "python")
        set(language_label "Python")
    elseif("${language}" STREQUAL "ruby")
        set(language_label "Ruby")
    elseif("${language}" STREQUAL "octave")
        set(language_label "Octave")
    elseif("${language}" STREQUAL "julia")
        set(language_label "Julia")
    elseif("${language}" STREQUAL "java")
        set(language_label "Java")
    elseif("${language}" STREQUAL "csharp")
        set(language_label "C#")
    elseif("${language}" STREQUAL "visual-basic")
        set(language_label "Visual Basic")
    elseif("${language}" STREQUAL "rust")
        set(language_label "Rust")
    elseif("${language}" STREQUAL "php")
        set(language_label "PHP")
    elseif("${language}" STREQUAL "perl")
        set(language_label "Perl")
    elseif("${language}" STREQUAL "prolog")
        set(language_label "Prolog")
    elseif("${language}" STREQUAL "haskell")
        set(language_label "Haskell")
    elseif("${language}" STREQUAL "fortran")
        set(language_label "Fortran")
    elseif("${language}" STREQUAL "common-lisp")
        set(language_label "Common Lisp")
    elseif("${language}" STREQUAL "tcl")
        set(language_label "Tcl")
    elseif("${language}" STREQUAL "guile")
        set(language_label "Guile")
    elseif("${language}" STREQUAL "ocaml")
        set(language_label "OCaml")
    elseif("${language}" STREQUAL "go")
        set(language_label "Go")
    elseif("${language}" STREQUAL "apl")
        set(language_label "APL")
    elseif("${language}" STREQUAL "cobol")
        set(language_label "COBOL")
    elseif("${language}" STREQUAL "swift")
        set(language_label "Swift")
    elseif("${language}" STREQUAL "pascal")
        set(language_label "Pascal")
    elseif("${language}" STREQUAL "dart")
        set(language_label "Dart")
    elseif("${language}" STREQUAL "ada")
        set(language_label "Ada")
    elseif("${language}" STREQUAL "objective-c")
        set(language_label "Objective-C")
    else()
        set(language_label "Lua")
    endif()
    add_custom_command(OUTPUT ${outputs}
        COMMAND ${command} -- ${ARG_FLAGS}
        DEPENDS ${depends}
        DEPFILE "${depfile}"
        VERBATIM COMMENT "Generating ${language_label} bindings: ${ARG_MODULE}")
endmacro()
