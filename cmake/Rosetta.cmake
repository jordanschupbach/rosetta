# Parse the enclosing public function's arguments directly, preserving literal
# semicolons in paths/flags rather than expanding ARGV through another call.
macro(_rosetta_generate language)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "R_PACKAGE" "HEADER;MODULE;OUTPUT;IR;DEPFILE;POLICY;CLANG;EXECUTABLE;COMPILE_COMMANDS;TRANSLATION_UNIT;COMMAND_INDEX;R_OUTPUT;OBJECT_SYSTEM;JULIA_OUTPUT;JAVA_OUTPUT;JAVA_PACKAGE;JAVA_API;JAVA_LIBRARY;CSHARP_OUTPUT;CSHARP_NAMESPACE;FORTRAN_OUTPUT;LISP_OUTPUT;GUILE_OUTPUT;GUILE_API;GUILE_MODULE;GUILE_EXTENSION;OCAML_OUTPUT;OCAML_API;GO_OUTPUT;GO_API;GO_PACKAGE;GO_MODULE_PATH;GO_LIBRARY;GNU_APL_OUTPUT;DYALOG_OUTPUT;APL_LIBRARY_DIR;APL_API;APL_PREFIX;COBOL_OUTPUT;COBOL_STRING_SIZE;COBOL_API;COBOL_PREFIX;COBOL_CALLBACKS;COBOL_TABLE_SIZE;COBOL_RESULT_SIZE;PYTHON_PARTS;PARTS;LUA_API;LUA_META;LISP_API;LISP_SYSTEM;LISP_NICKNAMES;JULIA_API;JULIA_PACKAGE;JULIA_LIBRARY;JULIA_PROJECT;CSHARP_API;CSHARP_LIBRARY;CSHARP_PROJECT;CSHARP_FUNCTIONS;VB_OUTPUT;VB_NAMESPACE;VB_LIBRARY;VB_PROJECT;VB_FUNCTIONS;RUST_OUTPUT;RUST_CRATE;RUST_LIBRARY;PHP_OUTPUT;PHP_NAMESPACE;PHP_LIBRARY;PERL_OUTPUT;PERL_PACKAGE;PERL_LIBRARY;SWIFT_OUTPUT;SWIFT_MODULE;SWIFT_LIBRARY;PASCAL_OUTPUT;PASCAL_UNIT;PASCAL_LIBRARY;DART_OUTPUT;DART_PACKAGE;DART_LIBRARY;ADA_OUTPUT;ADA_PACKAGE;ADA_LIBRARY;OBJC_OUTPUT;OBJC_PREFIX;OBJC_LIBRARY;PROLOG_OUTPUT;PROLOG_MODULE;PROLOG_LIBRARY;HASKELL_OUTPUT;HASKELL_MODULE;FORTRAN_API;FORTRAN_MODULE;RUBY_API;RUBY_MODULE;RUBY_OUTPUT;RUBY_NATIVE;OCTAVE_API;OCTAVE_OUTPUT;OCTAVE_PACKAGE;TCL_API;TCL_OUTPUT;TCL_PKGINDEX;TCL_NAMESPACE;TCL_LIBRARY;TCL_VERSION;JS_TYPES" "FLAGS")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid rosetta_generate_${language} arguments")
    endif()
    foreach(required HEADER MODULE OUTPUT)
        if(NOT DEFINED ARG_${required} OR "${ARG_${required}}" STREQUAL "")
            message(FATAL_ERROR "rosetta_generate_${language} requires ${required}")
        endif()
    endforeach()
    get_filename_component(header "${ARG_HEADER}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    get_filename_component(output "${ARG_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    if(NOT DEFINED ARG_DEPFILE)
        set(ARG_DEPFILE "${output}.d")
    endif()
    get_filename_component(depfile "${ARG_DEPFILE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    if(NOT DEFINED ARG_EXECUTABLE)
        if(TARGET rosetta)
            set(ARG_EXECUTABLE rosetta)
        else()
            find_program(ROSETTA_EXECUTABLE NAMES rosetta REQUIRED)
            set(ARG_EXECUTABLE "${ROSETTA_EXECUTABLE}")
        endif()
    endif()
    if(NOT DEFINED ARG_CLANG)
        find_program(ROSETTA_CLANG_EXECUTABLE NAMES clang++ REQUIRED)
        set(ARG_CLANG "${ROSETTA_CLANG_EXECUTABLE}")
    endif()
    set(outputs "${output}")
    set(depends "${ARG_EXECUTABLE}" "${header}")
    set(command "${ARG_EXECUTABLE}" "${header}" --language "${language}" --module "${ARG_MODULE}" --clang "${ARG_CLANG}"
        -o "${output}" --depfile "${depfile}")
    # PARTS (or PYTHON_PARTS) N: OUTPUT plus OUTPUT's stem + _1 .. _N-1, all compiled into the module.
    if(DEFINED ARG_PARTS)
        set(ARG_PYTHON_PARTS "${ARG_PARTS}")
    endif()
    if(DEFINED ARG_PYTHON_PARTS)
        if(NOT "${language}" STREQUAL "python" AND NOT "${language}" STREQUAL "r" AND NOT "${language}" STREQUAL "javascript" AND NOT "${language}" STREQUAL "visual-basic" AND NOT "${language}" STREQUAL "rust" AND NOT "${language}" STREQUAL "php" AND NOT "${language}" STREQUAL "perl" AND NOT "${language}" STREQUAL "swift" AND NOT "${language}" STREQUAL "pascal" AND NOT "${language}" STREQUAL "dart" AND NOT "${language}" STREQUAL "ada" AND NOT "${language}" STREQUAL "objective-c" AND NOT "${language}" STREQUAL "prolog" AND NOT "${language}" STREQUAL "haskell" AND NOT "${ARG_LUA_API}" STREQUAL "full"
                AND NOT "${ARG_LISP_API}" STREQUAL "full" AND NOT "${ARG_COBOL_API}" STREQUAL "full" AND NOT "${ARG_JULIA_API}" STREQUAL "full" AND NOT "${ARG_CSHARP_API}" STREQUAL "full" AND NOT "${ARG_FORTRAN_API}" STREQUAL "full" AND NOT "${ARG_RUBY_API}" STREQUAL "full" AND NOT "${ARG_OCTAVE_API}" STREQUAL "full" AND NOT "${ARG_TCL_API}" STREQUAL "full" AND NOT "${ARG_GUILE_API}" STREQUAL "full" AND NOT "${ARG_JAVA_API}" STREQUAL "full" AND NOT "${ARG_GO_API}" STREQUAL "full" AND NOT "${ARG_OCAML_API}" STREQUAL "full" AND NOT "${ARG_APL_API}" STREQUAL "full")
            message(FATAL_ERROR "PARTS requires rosetta_generate_python, rosetta_generate_r, rosetta_generate_javascript, rosetta_generate_visual_basic, rosetta_generate_rust, rosetta_generate_php, rosetta_generate_perl, rosetta_generate_swift, rosetta_generate_pascal, rosetta_generate_dart, rosetta_generate_ada, rosetta_generate_objc, rosetta_generate_prolog, rosetta_generate_haskell, or LUA_API/LISP_API/JULIA_API/CSHARP_API/FORTRAN_API/RUBY_API/OCTAVE_API/TCL_API/GUILE_API/JAVA_API/GO_API/OCAML_API/APL_API/COBOL_API full")
        endif()
        get_filename_component(part_dir "${output}" DIRECTORY)
        get_filename_component(part_stem "${output}" NAME_WLE)
        get_filename_component(part_ext "${output}" LAST_EXT)
        math(EXPR last_part "${ARG_PYTHON_PARTS} - 1")
        if(last_part GREATER 0)
            foreach(part RANGE 1 ${last_part})
                list(APPEND outputs "${part_dir}/${part_stem}_${part}${part_ext}")
            endforeach()
        endif()
        list(APPEND command --python-parts "${ARG_PYTHON_PARTS}")
    endif()
    # LUA_API full: the full Lua API, plus a LuaCATS stub (LUA_META, default library/MODULE.lua beside OUTPUT).
    if(DEFINED ARG_LUA_API OR DEFINED ARG_LUA_META)
        if(NOT "${language}" STREQUAL "lua")
            message(FATAL_ERROR "LUA_API and LUA_META require rosetta_generate_lua")
        endif()
        if(DEFINED ARG_LUA_API)
            list(APPEND command --lua-api "${ARG_LUA_API}")
        endif()
        if("${ARG_LUA_API}" STREQUAL "full")
            if(NOT DEFINED ARG_LUA_META)
                get_filename_component(meta_dir "${output}" DIRECTORY)
                set(ARG_LUA_META "${meta_dir}/library/${ARG_MODULE}.lua")
            endif()
            get_filename_component(lua_meta "${ARG_LUA_META}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
            list(APPEND outputs "${lua_meta}")
            list(APPEND command --lua-meta "${lua_meta}")
        elseif(DEFINED ARG_LUA_META)
            message(FATAL_ERROR "LUA_META requires LUA_API full")
        endif()
    endif()
    if("${language}" STREQUAL "r")
        if(NOT DEFINED ARG_R_OUTPUT)
            get_filename_component(r_dir "${output}" DIRECTORY)
            get_filename_component(r_stem "${output}" NAME_WLE)
            set(ARG_R_OUTPUT "${r_dir}/${r_stem}.R")
        endif()
        if(NOT DEFINED ARG_OBJECT_SYSTEM)
            set(ARG_OBJECT_SYSTEM r6)
        endif()
        get_filename_component(r_output "${ARG_R_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${r_output}")
        list(APPEND command --r-output "${r_output}" --object-system "${ARG_OBJECT_SYSTEM}")
        if(ARG_R_PACKAGE)
            list(APPEND command --r-package)
        endif()
    elseif(DEFINED ARG_R_OUTPUT OR DEFINED ARG_OBJECT_SYSTEM)
        message(FATAL_ERROR "R_OUTPUT and OBJECT_SYSTEM require rosetta_generate_r")
    endif()
    if("${language}" STREQUAL "julia")
        if(NOT DEFINED ARG_JULIA_OUTPUT)
            get_filename_component(julia_dir "${output}" DIRECTORY)
            get_filename_component(julia_stem "${output}" NAME_WLE)
            set(ARG_JULIA_OUTPUT "${julia_dir}/${julia_stem}.jl")
        endif()
        get_filename_component(julia_output "${ARG_JULIA_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${julia_output}")
        list(APPEND command --julia-output "${julia_output}")
        # JULIA_API full: abstract types, generic functions, @subclass and docstrings.
        # JULIA_PACKAGE names the Julia module, JULIA_PROJECT also writes a Project.toml.
        if(DEFINED ARG_JULIA_API)
            list(APPEND command --julia-api "${ARG_JULIA_API}")
        endif()
        if("${ARG_JULIA_API}" STREQUAL "full")
            if(DEFINED ARG_JULIA_PACKAGE)
                list(APPEND command --julia-package "${ARG_JULIA_PACKAGE}")
            endif()
            if(DEFINED ARG_JULIA_LIBRARY)
                list(APPEND command --julia-library "${ARG_JULIA_LIBRARY}")
            endif()
            if(DEFINED ARG_JULIA_PROJECT)
                get_filename_component(julia_project "${ARG_JULIA_PROJECT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
                list(APPEND outputs "${julia_project}")
                list(APPEND command --julia-project "${julia_project}")
            endif()
        elseif(DEFINED ARG_JULIA_PACKAGE OR DEFINED ARG_JULIA_LIBRARY OR DEFINED ARG_JULIA_PROJECT)
            message(FATAL_ERROR "JULIA_PACKAGE, JULIA_LIBRARY and JULIA_PROJECT require JULIA_API full")
        endif()
    elseif(DEFINED ARG_JULIA_OUTPUT OR DEFINED ARG_JULIA_API)
        message(FATAL_ERROR "JULIA_OUTPUT and JULIA_API require rosetta_generate_julia")
    endif()
    if("${language}" STREQUAL "javascript")
        if(NOT DEFINED ARG_JS_TYPES)
            get_filename_component(js_dir "${output}" DIRECTORY)
            set(ARG_JS_TYPES "${js_dir}/${ARG_MODULE}.d.ts")
        endif()
        get_filename_component(js_types "${ARG_JS_TYPES}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${js_types}")
        list(APPEND command --js-types "${js_types}")
    elseif(DEFINED ARG_JS_TYPES)
        message(FATAL_ERROR "JS_TYPES requires rosetta_generate_javascript")
    endif()
    if("${language}" STREQUAL "common-lisp")
        if(NOT DEFINED ARG_LISP_OUTPUT)
            get_filename_component(lisp_dir "${output}" DIRECTORY)
            get_filename_component(lisp_stem "${output}" NAME_WLE)
            set(ARG_LISP_OUTPUT "${lisp_dir}/${lisp_stem}.lisp")
        endif()
        get_filename_component(lisp_output "${ARG_LISP_OUTPUT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
        list(APPEND outputs "${lisp_output}")
        list(APPEND command --lisp-output "${lisp_output}")
        # LISP_API full: CLOS classes and generics, plus an ASDF system (LISP_SYSTEM, default
        # MODULE.asd beside the .lisp file). LISP_NICKNAMES is a list of package nicknames.
        if(DEFINED ARG_LISP_API)
            list(APPEND command --lisp-api "${ARG_LISP_API}")
        endif()
        if("${ARG_LISP_API}" STREQUAL "full")
            if(NOT DEFINED ARG_LISP_SYSTEM)
                get_filename_component(lisp_dir "${lisp_output}" DIRECTORY)
                set(ARG_LISP_SYSTEM "${lisp_dir}/${ARG_MODULE}.asd")
            endif()
            get_filename_component(lisp_system "${ARG_LISP_SYSTEM}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
            list(APPEND outputs "${lisp_system}")
            list(APPEND command --lisp-system "${lisp_system}")
            if(DEFINED ARG_LISP_NICKNAMES)
                string(REPLACE ";" "," lisp_nicknames "${ARG_LISP_NICKNAMES}")
                list(APPEND command --lisp-nicknames "${lisp_nicknames}")
            endif()
        elseif(DEFINED ARG_LISP_SYSTEM OR DEFINED ARG_LISP_NICKNAMES)
            message(FATAL_ERROR "LISP_SYSTEM and LISP_NICKNAMES require LISP_API full")
        endif()
    elseif(DEFINED ARG_LISP_OUTPUT OR DEFINED ARG_LISP_API)
        message(FATAL_ERROR "LISP_OUTPUT and LISP_API require rosetta_generate_common_lisp")
    endif()
    if("${language}" STREQUAL "guile")
        # GUILE_API full: a libguile extension plus the documented Scheme module GUILE_OUTPUT
        # (default: the last part of GUILE_MODULE, else MODULE, .scm beside OUTPUT). Policy
        # submodules are written beside it (MODULE/SUB.scm) without being declared outputs.
        set(guile_file "${ARG_MODULE}")
        if(DEFINED ARG_GUILE_MODULE)
            string(REGEX REPLACE "[()./]" " " guile_parts "${ARG_GUILE_MODULE}")
            string(STRIP "${guile_parts}" guile_parts)
