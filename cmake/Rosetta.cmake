# Precompile a generated Guile module (GUILE_API full) at build time, so that the first
# (use-modules ...) needn't auto-compile it:
#   rosetta_compile_guile(TARGET <name> MODULE_FILE <dir>/<m>.scm [OUTPUT_DIR <ccache dir>]
#                         [DEPENDS <extension target> ...] [INSTALL_DESTINATION <dir>]
#                         [WARNINGS <guild warning> ...] [WARNINGS_AS_ERRORS] [GUILD <guild>])
# runs `guild compile` on <m>.scm and every <m>/**.scm (policy submodules), writing <m>.go and
# <m>/**.go into OUTPUT_DIR (default ${CMAKE_CURRENT_BINARY_DIR}/<name>-ccache). Put OUTPUT_DIR on
# GUILE_LOAD_COMPILED_PATH and the .scm directory on GUILE_LOAD_PATH (the module finds its
# extension through %load-path). DEPENDS should name the extension library: submodules load the
# module while compiling. INSTALL_DESTINATION installs the .go files, typically
# lib/guile/<effective-version>/site-ccache or `pkg-config --variable=siteccachedir guile-3.0`.
function(rosetta_compile_guile)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "WARNINGS_AS_ERRORS" "TARGET;MODULE_FILE;OUTPUT_DIR;INSTALL_DESTINATION;GUILD"
        "DEPENDS;WARNINGS")
    if(NOT ARG_TARGET OR NOT ARG_MODULE_FILE)
        message(FATAL_ERROR "rosetta_compile_guile requires TARGET and MODULE_FILE")
    endif()
    if(NOT ARG_GUILD)
        find_program(ROSETTA_GUILD_EXECUTABLE NAMES guild3.0 guild REQUIRED)
        set(ARG_GUILD "${ROSETTA_GUILD_EXECUTABLE}")
    endif()
    if(NOT ARG_OUTPUT_DIR)
        set(ARG_OUTPUT_DIR "${CMAKE_CURRENT_BINARY_DIR}/${ARG_TARGET}-ccache")
    endif()
    if(NOT ARG_WARNINGS)
        set(ARG_WARNINGS unbound-variable macro-use-before-definition arity-mismatch shadowed-toplevel format)
    endif()
    get_filename_component(module_file "${ARG_MODULE_FILE}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    get_filename_component(output_dir "${ARG_OUTPUT_DIR}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    set(script "${CMAKE_BINARY_DIR}/rosetta_compile_guile.cmake")
    # Written through configure_file so that reconfiguring doesn't touch it (and recompile).
    file(WRITE "${script}.in" [==[
# Written by rosetta_compile_guile (cmake/Rosetta.cmake).
get_filename_component(dir "${MODULE_FILE}" DIRECTORY)
get_filename_component(stem "${MODULE_FILE}" NAME_WE)
file(GLOB_RECURSE submodules RELATIVE "${dir}" "${dir}/${stem}/*.scm")
list(SORT submodules)
set(ENV{GUILE_LOAD_PATH} "${dir}")
set(ENV{GUILE_LOAD_COMPILED_PATH} "${OUTPUT_DIR}")
set(ENV{GUILE_AUTO_COMPILE} "0")
set(flags)
string(REPLACE "," ";" WARNINGS "${WARNINGS}")
foreach(warning ${WARNINGS})
    list(APPEND flags "-W${warning}")
endforeach()
foreach(file "${stem}.scm" ${submodules})
    string(REGEX REPLACE "\\.scm$" ".go" go "${file}")
    execute_process(COMMAND "${GUILD}" compile -L "${dir}" ${flags} -o "${OUTPUT_DIR}/${go}" "${dir}/${file}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE output)
    string(REGEX REPLACE "(^|\n)wrote `[^\n]*" "" diagnostics "${output}")
    string(STRIP "${diagnostics}" diagnostics)
    if(NOT status EQUAL 0 OR (WERROR AND diagnostics MATCHES "warning:"))
        message(FATAL_ERROR "guild compile ${file} failed:\n${output}")
    elseif(diagnostics)
        message("${diagnostics}")
    endif()
endforeach()
file(TOUCH "${STAMP}")
]==])
    configure_file("${script}.in" "${script}" COPYONLY)
    string(REPLACE ";" "," warnings "${ARG_WARNINGS}")
    get_filename_component(stem "${module_file}" NAME_WE)
    set(stamp "${output_dir}/.${stem}.compiled")
    set(werror OFF)
    if(ARG_WARNINGS_AS_ERRORS)
        set(werror ON)
    endif()
    add_custom_command(OUTPUT "${stamp}"
        COMMAND "${CMAKE_COMMAND}" -E make_directory "${output_dir}"
        COMMAND "${CMAKE_COMMAND}" "-DGUILD=${ARG_GUILD}" "-DMODULE_FILE=${module_file}" "-DOUTPUT_DIR=${output_dir}"
            "-DWARNINGS=${warnings}" "-DWERROR=${werror}" "-DSTAMP=${stamp}" -P "${script}"
        DEPENDS "${module_file}" "${script}" ${ARG_DEPENDS}
        COMMENT "Compiling Guile module ${module_file}" VERBATIM)
    add_custom_target(${ARG_TARGET} ALL DEPENDS "${stamp}")
    if(ARG_INSTALL_DESTINATION)
        install(DIRECTORY "${output_dir}/" DESTINATION "${ARG_INSTALL_DESTINATION}" FILES_MATCHING PATTERN "*.go")
    endif()
endfunction()

