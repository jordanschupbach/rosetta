option(ROSETTA_BUILD_COBOL_EXAMPLES "Build and test COBOL bindings (requires GnuCOBOL 3)" OFF)
if(ROSETTA_BUILD_COBOL_EXAMPLES)
    find_program(ROSETTA_COBC_EXECUTABLE cobc REQUIRED)
    # build/cobol holds each module's copybook NAME.cpy and libNAME.a, the
    # stubs a COBOL program links (with cobc -fstatic-call, so each CALL
    # literal is a direct reference).
    set(cobol_dir "${CMAKE_CURRENT_BINARY_DIR}/cobol")
    set(cobol_generated "${CMAKE_CURRENT_BINARY_DIR}/generated/cobol")
    set(cobol_modules demo verify)
    if(BUILD_TESTING)
        list(APPEND cobol_modules names)
    endif()
    set(cobol_copybooks)
    set(cobol_link)
    foreach(example ${cobol_modules})
        set(module cobol_${example})
        if(example STREQUAL "demo")
            set(header "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_demo.hpp")
            set(policy POLICY "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_demo.policy.json")
        elseif(example STREQUAL "verify")
            set(header "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_verification.hpp")
            set(policy POLICY "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_verification.policy.json")
        else()
            set(header "${CMAKE_CURRENT_SOURCE_DIR}/tests/cobol_names.hpp")
            set(policy POLICY "${CMAKE_CURRENT_SOURCE_DIR}/tests/cobol_names.policy.json")
        endif()
        rosetta_generate_cobol(HEADER "${header}" MODULE ${module} OUTPUT "${cobol_generated}/${example}.cpp"
            COBOL_OUTPUT "${cobol_dir}/${module}.cpy" CLANG "${ROSETTA_CLANG_EXECUTABLE}" ${policy})
        add_library(rosetta_cobol_${example} STATIC "${cobol_generated}/${example}.cpp")
        set_target_properties(rosetta_cobol_${example} PROPERTIES OUTPUT_NAME ${module} PREFIX "lib" SUFFIX ".a"
            ARCHIVE_OUTPUT_DIRECTORY "${cobol_dir}" POSITION_INDEPENDENT_CODE ON)
        target_compile_features(rosetta_cobol_${example} PRIVATE cxx_std_17)
        rosetta_warnings(rosetta_cobol_${example})
        list(APPEND cobol_copybooks "${cobol_dir}/${module}.cpy")
        list(APPEND cobol_link -l${module})
    endforeach()
    target_sources(rosetta_cobol_verify PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/examples/r_verification.cpp")
    target_compile_features(rosetta_cobol_verify PRIVATE cxx_std_20)
    add_custom_target(rosetta_cobol_copybooks ALL DEPENDS ${cobol_copybooks})
    # The C++ runtime the stubs need, passed to the linker through cobc -Q.
    if(APPLE)
        set(cobol_cxx -Q -lc++)
    else()
        set(cobol_cxx -Q -lstdc++ -Q -lm)
    endif()
    if(BUILD_TESTING)
        # One program per source format: the copybooks fit both.
        foreach(program free fixed)
            set(format)
            set(source "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_cobol.cob")
            if(program STREQUAL "free")
                set(format -free)
            else()
                set(source "${CMAKE_CURRENT_SOURCE_DIR}/tests/test_cobol_fixed.cob")
            endif()
            set(binary "${cobol_dir}/test_cobol_${program}")
            add_custom_command(OUTPUT "${binary}"
                COMMAND "${ROSETTA_COBC_EXECUTABLE}" -x ${format} -fstatic-call -Wall -I "${cobol_dir}" -o "${binary}" "${source}"
                    -L "${cobol_dir}" ${cobol_link} ${cobol_cxx}
                DEPENDS "${source}" ${cobol_copybooks} rosetta_cobol_demo rosetta_cobol_verify rosetta_cobol_names
                COMMENT "Compiling COBOL tests (${program} format)" VERBATIM)
            add_custom_target(rosetta_cobol_${program}_tests ALL DEPENDS "${binary}")
        endforeach()
        foreach(family scalars names objects features exit)
            add_test(NAME cobol_${family} COMMAND "${cobol_dir}/test_cobol_free" ${family})
            set_tests_properties(cobol_${family} PROPERTIES TIMEOUT 60
                PASS_REGULAR_EXPRESSION "ROSETTA PASS ${family}" FAIL_REGULAR_EXPRESSION "FAIL")
        endforeach()
        add_test(NAME cobol_fixed_format COMMAND "${cobol_dir}/test_cobol_fixed")
        set_tests_properties(cobol_fixed_format PROPERTIES TIMEOUT 60 PASS_REGULAR_EXPRESSION "ROSETTA PASS fixed" FAIL_REGULAR_EXPRESSION "FAIL")
    endif()
endif()
