{
  "version": 1,
  "select": "all",
  "names": "flat",
  "sequences": "vector",
  "qualify": ["features::legacy"],
  "modules": { "features::data": "data" },
  "copy_types": ["features::Stamp"],
  "exceptions": [
    { "match": "features::repeat", "map": [["std::exception", "RuntimeError"]] }
  ],
  "templates": { "IntStack": "features::Stack<int>", "clamp_int": "features::clamp_to<int>",
                 "clamp_real": "features::clamp_to<double>" },
  "extend": {
    "features::Shape": { "label": "features::shape_label" },
    "features::Circle": { "unit": "features::unit_circle" },
    "features::legacy::Circle": { "diameter": "features::circle_diameter" }
  },
  "rename": { "features::Vec2::dot": "inner" },
  "exclude": ["features::borrowed_shape"],
  "returns": {}
}
