*> Runtime tests of the full COBOL API (--cobol-api full) on tests/cobol_full_features.hpp
*> (examples/python_features.hpp plus COBOL-only cases).
*> Prints "ROSETTA PASS full" when every check passes.
IDENTIFICATION DIVISION.
PROGRAM-ID. ROSETTA-COBOL-FULL.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "features.cpy".
01 T-FAILURES      PIC 9(4) VALUE 0.
01 T-CHECKS        PIC 9(4) VALUE 0.
01 T-LABEL         PIC X(40).
01 T-WANT-KIND     PIC X(10).
01 T-CIRCLE        USAGE BINARY-DOUBLE UNSIGNED.
01 T-SQUARE        USAGE BINARY-DOUBLE UNSIGNED.
01 T-SHAPE         USAGE BINARY-DOUBLE UNSIGNED.
01 T-VEC           USAGE BINARY-DOUBLE UNSIGNED.
01 T-VEC-B         USAGE BINARY-DOUBLE UNSIGNED.
01 T-OBJ           USAGE BINARY-DOUBLE UNSIGNED.
01 T-MAP           USAGE BINARY-DOUBLE UNSIGNED.
01 T-I             USAGE BINARY-LONG SIGNED.
01 T-TEXT          PIC X(40).
01 T-SUM           USAGE COMP-2.
01 VISITS          PIC 9(4) EXTERNAL.

PROCEDURE DIVISION.
    MOVE 0 TO VISITS
    PERFORM SCALARS
    PERFORM DEFAULTS-AND-OVERLOADS
    PERFORM OBJECTS
    PERFORM CONTAINERS
    PERFORM CALLBACKS
    PERFORM OVERRIDES
    PERFORM ERRORS
    IF T-FAILURES = 0
        DISPLAY "ROSETTA PASS full (" T-CHECKS " checks)"
    ELSE
        DISPLAY T-FAILURES " FAILURES"
    END-IF
    MOVE 0 TO RETURN-CODE
    STOP RUN.

CHECK-PASSED.
    ADD 1 TO T-CHECKS.
FAILED.
    ADD 1 TO T-CHECKS
    ADD 1 TO T-FAILURES
    DISPLAY "FAIL " FUNCTION TRIM(T-LABEL).
EXPECT-OK.
    IF NOT FT-STATUS-OK OR RETURN-CODE NOT = 0
        PERFORM FAILED
        DISPLAY "  " FUNCTION TRIM(FT-STATUS-KIND) ": " FT-STATUS-MESSAGE(1:FT-STATUS-LENGTH)
    END-IF.
EXPECT-ERROR.
    IF FT-STATUS-KIND NOT = T-WANT-KIND OR RETURN-CODE NOT = FT-STATUS-CODE OR FT-STATUS-LENGTH = 0
        PERFORM FAILED
        DISPLAY "  got " FUNCTION TRIM(FT-STATUS-KIND) " " RETURN-CODE
    ELSE
        PERFORM CHECK-PASSED
    END-IF.

SCALARS.
    MOVE "enum argument" TO T-LABEL
    SET FT-FILLED-FILL-SOLID TO TRUE
    CALL "ft_filled" USING FT-FILLED FT-STATUS
    PERFORM EXPECT-OK
    IF FT-FILLED-RESULT = 1 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "enum constant" TO T-LABEL
    MOVE FT-KIND-CUSTOM TO T-I
    IF T-I = 7 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "string and char" TO T-LABEL
    MOVE "z" TO FT-REPEAT-C
    MOVE 3 TO FT-REPEAT-COUNT
    CALL "ft_repeat" USING FT-REPEAT FT-STATUS
    PERFORM EXPECT-OK
    IF FT-REPEAT-RESULT(1:FT-REPEAT-RESULT-LENGTH) = "zzz" AND FT-REPEAT-RESULT-LENGTH = 3
        PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "submodule function" TO T-LABEL
    MOVE "ab" TO FT-DATA-REPEAT-TEXT
    CALL "ft_data_repeat" USING FT-DATA-REPEAT FT-STATUS
    PERFORM EXPECT-OK
    IF FT-DATA-REPEAT-RESULT(1:FT-DATA-REPEAT-RESULT-LENGTH) = "abab" AND FT-DATA-REPEAT-RESULT-LENGTH = 4
        PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "char result" TO T-LABEL
    MOVE "hello" TO FT-INITIAL-TEXT
    CALL "ft_initial" USING FT-INITIAL FT-STATUS
    IF FT-INITIAL-RESULT = "h" PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "template specialization" TO T-LABEL
    MOVE 42 TO FT-CLAMP-INT-VALUE
    CALL "ft_clamp_int" USING FT-CLAMP-INT FT-STATUS
    PERFORM EXPECT-OK
    IF FT-CLAMP-INT-RESULT = 10 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "static constant" TO T-LABEL
    CALL "ft_shape_sides_unknown_get" USING FT-SHAPE-SIDES-UNKNOWN FT-STATUS
    IF FT-SHAPE-SIDES-UNKNOWN-VALUE = -1 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF.

DEFAULTS-AND-OVERLOADS.
    MOVE "defaults: required only" TO T-LABEL
    MOVE 1 TO FT-ADD-A
    CALL "ft_add" USING FT-ADD FT-STATUS
    PERFORM EXPECT-OK
    IF FT-ADD-RESULT = 111 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "defaults: all given" TO T-LABEL
    MOVE 3 TO FT-ADD-GIVEN
    MOVE 2 TO FT-ADD-B
    MOVE 3 TO FT-ADD-C
    CALL "ft_add" USING FT-ADD FT-STATUS
    IF FT-ADD-RESULT = 6 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "defaults: every kind" TO T-LABEL
    CALL "ft_defaults" USING FT-DEFAULTS FT-STATUS
    PERFORM EXPECT-OK
    IF FT-DEFAULTS-RESULT(1:FT-DEFAULTS-RESULT-LENGTH) = "x*1-1.500000"
        PERFORM CHECK-PASSED ELSE PERFORM FAILED
        DISPLAY "  " FT-DEFAULTS-RESULT(1:FT-DEFAULTS-RESULT-LENGTH) END-IF
    MOVE "bad -GIVEN" TO T-LABEL
    MOVE 9 TO FT-ADD-GIVEN
    CALL "ft_add" USING FT-ADD FT-STATUS
    MOVE "argument" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "overloads" TO T-LABEL
    MOVE 2.5 TO FT-PICK-DOUBLE-ARG-1
    CALL "ft_pick_double" USING FT-PICK-DOUBLE FT-STATUS
    PERFORM EXPECT-OK
    IF FT-PICK-DOUBLE-RESULT(1:FT-PICK-DOUBLE-RESULT-LENGTH) = "double"
        PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "abc" TO FT-PICK-STRING-ARG-1
    CALL "ft_pick_string" USING FT-PICK-STRING FT-STATUS
    IF FT-PICK-STRING-RESULT(1:6) = "string" PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "in/out pair" TO T-LABEL
    MOVE 1 TO FT-SWAP-ENDS-ENDS-FIRST
    MOVE 2 TO FT-SWAP-ENDS-ENDS-SECOND
    CALL "ft_swap_ends" USING FT-SWAP-ENDS FT-STATUS
    PERFORM EXPECT-OK
    IF FT-SWAP-ENDS-ENDS-FIRST = 2 AND FT-SWAP-ENDS-ENDS-SECOND = 1 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "in/out string" TO T-LABEL
    MOVE "hi" TO FT-SUFFIX-LABEL
    CALL "ft_suffix" USING FT-SUFFIX FT-STATUS
    PERFORM EXPECT-OK
    IF FT-SUFFIX-LABEL(1:FT-SUFFIX-LABEL-LENGTH) = "hi!" PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF.

OBJECTS.
    MOVE "constructor" TO T-LABEL
    MOVE 2 TO FT-CIRCLE-NEW-RADIUS
    CALL "ft_circle_new" USING FT-CIRCLE-NEW FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-CIRCLE-NEW-RESULT TO T-CIRCLE
    MOVE "base method on derived handle" TO T-LABEL
    MOVE T-CIRCLE TO FT-SHAPE-AREA-SELF
    CALL "ft_shape_area" USING FT-SHAPE-AREA FT-STATUS
    PERFORM EXPECT-OK
    IF FT-SHAPE-AREA-RESULT = 12 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "derived to base parameter" TO T-LABEL
    MOVE T-CIRCLE TO FT-DESCRIBE-SHAPE
    CALL "ft_describe" USING FT-DESCRIBE FT-STATUS
    IF FT-DESCRIBE-RESULT(1:FT-DESCRIBE-RESULT-LENGTH) = "circle:0" PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "extension method" TO T-LABEL
    MOVE T-CIRCLE TO FT-CIRCLE-DIAMETER-SELF
    CALL "ft_circle_diameter" USING FT-CIRCLE-DIAMETER FT-STATUS
    PERFORM EXPECT-OK
    IF FT-CIRCLE-DIAMETER-RESULT = 4 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "most-derived class of a result" TO T-LABEL
    SET FT-MAKE-SHAPE-KIND-SQUARE TO TRUE
    MOVE 3 TO FT-MAKE-SHAPE-SIZE
    CALL "ft_make_shape" USING FT-MAKE-SHAPE FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-MAKE-SHAPE-RESULT TO T-SQUARE
    MOVE T-SQUARE TO FT-SQUARE-SIDE-SELF
    CALL "ft_square_side_get" USING FT-SQUARE-SIDE FT-STATUS
    PERFORM EXPECT-OK
    IF FT-SQUARE-SIDE-VALUE = 3 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "field write" TO T-LABEL
    MOVE 5 TO FT-SQUARE-SIDE-VALUE
    CALL "ft_square_side_set" USING FT-SQUARE-SIDE FT-STATUS
    MOVE T-SQUARE TO FT-SHAPE-AREA-SELF
    CALL "ft_shape_area" USING FT-SHAPE-AREA FT-STATUS
    IF FT-SHAPE-AREA-RESULT = 25 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "handle type" TO T-LABEL
    MOVE T-SQUARE TO FT-HANDLE-SELF
    CALL "ft_handle_type" USING FT-HANDLE FT-STATUS
    IF FT-HANDLE-TYPE(1:6) = "SQUARE" PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "wrong class" TO T-LABEL
    MOVE T-SQUARE TO FT-CIRCLE-RADIUS-SELF
    CALL "ft_circle_radius" USING FT-CIRCLE-RADIUS FT-STATUS
    MOVE "argument" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "operators and value results" TO T-LABEL
    MOVE 1 TO FT-VEC2-NEW-DOUBLE-DOUBLE-X
    MOVE 2 TO FT-VEC2-NEW-DOUBLE-DOUBLE-Y
    CALL "ft_vec2_new_double_double" USING FT-VEC2-NEW-DOUBLE-DOUBLE FT-STATUS
    MOVE FT-VEC2-NEW-DOUBLE-DOUBLE-RESULT TO T-VEC
    MOVE T-VEC TO FT-VEC2-PLUS-SELF FT-VEC2-PLUS-OTHER
    CALL "ft_vec2_plus" USING FT-VEC2-PLUS FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-VEC2-PLUS-RESULT TO FT-VEC2-Y-SELF
    CALL "ft_vec2_y_get" USING FT-VEC2-Y FT-STATUS
    IF FT-VEC2-Y-VALUE = 4 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE FT-VEC2-PLUS-RESULT TO FT-HANDLE-SELF
    CALL "ft_close" USING FT-HANDLE FT-STATUS
    MOVE "borrowed member reference" TO T-LABEL
    CALL "ft_segment_new" USING FT-SEGMENT-NEW FT-STATUS
    MOVE FT-SEGMENT-NEW-RESULT TO T-OBJ FT-SEGMENT-FIRST-SELF
    CALL "ft_segment_first" USING FT-SEGMENT-FIRST FT-STATUS
    MOVE FT-SEGMENT-FIRST-RESULT TO FT-VEC2-X-SELF
    MOVE T-OBJ TO FT-HANDLE-SELF
    CALL "ft_close" USING FT-HANDLE FT-STATUS
    MOVE 9 TO FT-VEC2-X-VALUE
    CALL "ft_vec2_x_set" USING FT-VEC2-X FT-STATUS
    PERFORM EXPECT-OK
    MOVE "close twice" TO T-LABEL
    MOVE FT-SEGMENT-FIRST-RESULT TO FT-HANDLE-SELF
    CALL "ft_close" USING FT-HANDLE FT-STATUS
    CALL "ft_close" USING FT-HANDLE FT-STATUS
    PERFORM EXPECT-OK
    CALL "ft_handle_open" USING FT-HANDLE FT-STATUS
    IF FT-HANDLE-OPEN = 0 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "ownership to C++" TO T-LABEL
    CALL "ft_canvas_new" USING FT-CANVAS-NEW FT-STATUS
    MOVE FT-CANVAS-NEW-RESULT TO T-OBJ FT-CANVAS-ADD-SELF FT-CANVAS-TOTAL-SELF
    MOVE T-CIRCLE TO FT-CANVAS-ADD-SHAPE
    CALL "ft_canvas_add" USING FT-CANVAS-ADD FT-STATUS
    PERFORM EXPECT-OK
    CALL "ft_canvas_total" USING FT-CANVAS-TOTAL FT-STATUS
    IF FT-CANVAS-TOTAL-RESULT = 12 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE T-CIRCLE TO FT-HANDLE-SELF
    CALL "ft_handle_open" USING FT-HANDLE FT-STATUS
    IF FT-HANDLE-OPEN = 0 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "shared ownership" TO T-LABEL
    MOVE T-OBJ TO FT-CANVAS-SHARE-SELF
    MOVE T-SQUARE TO FT-CANVAS-SHARE-SHAPE
    CALL "ft_canvas_share" USING FT-CANVAS-SHARE FT-STATUS
    MOVE T-SQUARE TO FT-HANDLE-SELF
    CALL "ft_close" USING FT-HANDLE FT-STATUS
    CALL "ft_canvas_total" USING FT-CANVAS-TOTAL FT-STATUS
    IF FT-CANVAS-TOTAL-RESULT = 37 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE T-OBJ TO FT-HANDLE-SELF
    CALL "ft_close" USING FT-HANDLE FT-STATUS
    MOVE "reference field" TO T-LABEL
    CALL "ft_aim_new" USING FT-AIM-NEW FT-STATUS
    MOVE FT-AIM-NEW-RESULT TO T-OBJ FT-AIM-TARGET-SELF FT-AIM-ORIGIN-SELF
    CALL "ft_aim_target_get" USING FT-AIM-TARGET FT-STATUS
    MOVE FT-AIM-TARGET-VALUE TO FT-TARGET-POINT-SELF
    CALL "ft_target_point_get" USING FT-TARGET-POINT FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-TARGET-POINT-VALUE TO FT-VEC2-X-SELF
    MOVE 6 TO FT-VEC2-X-VALUE
    CALL "ft_vec2_x_set" USING FT-VEC2-X FT-STATUS
    CALL "ft_aim_origin_get" USING FT-AIM-ORIGIN FT-STATUS
    MOVE FT-AIM-ORIGIN-VALUE TO FT-VEC2-X-SELF
    CALL "ft_vec2_x_get" USING FT-VEC2-X FT-STATUS
    IF FT-VEC2-X-VALUE = 6 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE T-OBJ TO FT-HANDLE-SELF
    CALL "ft_close" USING FT-HANDLE FT-STATUS.

CONTAINERS.
    MOVE "vector from a table" TO T-LABEL
    MOVE 3 TO FT-VECTOR-DOUBLE-TABLE-COUNT
    MOVE 4 TO FT-VECTOR-DOUBLE-TABLE-ITEM(1)
    MOVE 1 TO FT-VECTOR-DOUBLE-TABLE-ITEM(2)
    MOVE 7 TO FT-VECTOR-DOUBLE-TABLE-ITEM(3)
    CALL "ft_vector_double_from_table" USING FT-VECTOR-DOUBLE-TABLE FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-VECTOR-DOUBLE-TABLE-SELF TO T-VEC
    MOVE T-VEC TO FT-MIN-MAX-VALUES
    CALL "ft_min_max" USING FT-MIN-MAX FT-STATUS
    PERFORM EXPECT-OK
    IF FT-MIN-MAX-RESULT-FIRST = 1 AND FT-MIN-MAX-RESULT-SECOND = 7 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "in-place modification" TO T-LABEL
    MOVE T-VEC TO FT-SCALE-VALUES
    MOVE 2 TO FT-SCALE-FACTOR
    CALL "ft_scale" USING FT-SCALE FT-STATUS
    MOVE T-VEC TO FT-VECTOR-DOUBLE-SELF
    MOVE 3 TO FT-VECTOR-DOUBLE-INDEX
    CALL "ft_vector_double_get" USING FT-VECTOR-DOUBLE FT-STATUS
    IF FT-VECTOR-DOUBLE-VALUE = 14 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "push, size and to_table" TO T-LABEL
    MOVE 5 TO FT-VECTOR-DOUBLE-VALUE
    CALL "ft_vector_double_push" USING FT-VECTOR-DOUBLE FT-STATUS
    CALL "ft_vector_double_size" USING FT-VECTOR-DOUBLE FT-STATUS
    MOVE T-VEC TO FT-VECTOR-DOUBLE-TABLE-SELF
    MOVE 2 TO FT-VECTOR-DOUBLE-TABLE-START
    CALL "ft_vector_double_to_table" USING FT-VECTOR-DOUBLE-TABLE FT-STATUS
    PERFORM EXPECT-OK
    IF FT-VECTOR-DOUBLE-SIZE = 4 AND FT-VECTOR-DOUBLE-TABLE-COUNT = 3 AND FT-VECTOR-DOUBLE-TABLE-ITEM(3) = 5
        PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "index error" TO T-LABEL
    MOVE 9 TO FT-VECTOR-DOUBLE-INDEX
    CALL "ft_vector_double_get" USING FT-VECTOR-DOUBLE FT-STATUS
    MOVE "index" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "pair error from C++" TO T-LABEL
    CALL "ft_vector_double_new" USING FT-VECTOR-DOUBLE FT-STATUS
    MOVE FT-VECTOR-DOUBLE-SELF TO FT-MIN-MAX-VALUES
    CALL "ft_min_max" USING FT-MIN-MAX FT-STATUS
    MOVE "index" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "optional results" TO T-LABEL
    MOVE 3 TO FT-VECTOR-INT-TABLE-COUNT
    MOVE 5 TO FT-VECTOR-INT-TABLE-ITEM(1)
    MOVE 6 TO FT-VECTOR-INT-TABLE-ITEM(2)
    MOVE 7 TO FT-VECTOR-INT-TABLE-ITEM(3)
    CALL "ft_vector_int_from_table" USING FT-VECTOR-INT-TABLE FT-STATUS
    MOVE FT-VECTOR-INT-TABLE-SELF TO FT-FIND-VALUES
    MOVE 7 TO FT-FIND-WANTED
    CALL "ft_find" USING FT-FIND FT-STATUS
    IF FT-FIND-RESULT-PRESENT = 1 AND FT-FIND-RESULT = 2 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE 8 TO FT-FIND-WANTED
    CALL "ft_find" USING FT-FIND FT-STATUS
    IF FT-FIND-RESULT-PRESENT = 0 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "string vectors and maps" TO T-LABEL
    MOVE 3 TO FT-VECTOR-STRING-TABLE-COUNT
    MOVE "b" TO FT-VECTOR-STRING-TABLE-ITEM(1)
    MOVE "a" TO FT-VECTOR-STRING-TABLE-ITEM(2)
    MOVE "b" TO FT-VECTOR-STRING-TABLE-ITEM(3)
    CALL "ft_vector_string_from_table" USING FT-VECTOR-STRING-TABLE FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-VECTOR-STRING-TABLE-SELF TO FT-COUNT-WORDS-WORDS
    CALL "ft_count_words" USING FT-COUNT-WORDS FT-STATUS
    MOVE FT-COUNT-WORDS-RESULT TO T-MAP FT-MAP-STRING-INT-SELF
    MOVE "b" TO FT-MAP-STRING-INT-KEY
    CALL "ft_map_string_int_get" USING FT-MAP-STRING-INT FT-STATUS
    PERFORM EXPECT-OK
    IF FT-MAP-STRING-INT-VALUE = 2 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    CALL "ft_map_string_int_keys" USING FT-MAP-STRING-INT FT-STATUS
    MOVE FT-MAP-STRING-INT-KEYS TO FT-VECTOR-STRING-TABLE-SELF
    MOVE 1 TO FT-VECTOR-STRING-TABLE-START
    CALL "ft_vector_string_to_table" USING FT-VECTOR-STRING-TABLE FT-STATUS
    IF FT-VECTOR-STRING-TABLE-COUNT = 2 AND FT-VECTOR-STRING-TABLE-ITEM(1) = "a"
        AND FT-VECTOR-STRING-TABLE-ITEM-LENGTH(1) = 1 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "c" TO FT-MAP-STRING-INT-KEY
    CALL "ft_map_string_int_get" USING FT-MAP-STRING-INT FT-STATUS
    MOVE "index" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "nested vectors" TO T-LABEL
    CALL "ft_vector_vector_double_new" USING FT-VECTOR-VECTOR-DOUBLE FT-STATUS
    MOVE T-VEC TO FT-VECTOR-VECTOR-DOUBLE-VALUE
    CALL "ft_vector_vector_double_push" USING FT-VECTOR-VECTOR-DOUBLE FT-STATUS
    CALL "ft_vector_vector_double_push" USING FT-VECTOR-VECTOR-DOUBLE FT-STATUS
    MOVE FT-VECTOR-VECTOR-DOUBLE-SELF TO FT-TRANSPOSE-ROWS
    CALL "ft_transpose" USING FT-TRANSPOSE FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-TRANSPOSE-RESULT TO FT-VECTOR-VECTOR-DOUBLE-SELF
    CALL "ft_vector_vector_double_size" USING FT-VECTOR-VECTOR-DOUBLE FT-STATUS
    IF FT-VECTOR-VECTOR-DOUBLE-SIZE = 4 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "vector of shared objects" TO T-LABEL
    MOVE 2 TO FT-CIRCLE-NEW-RADIUS
    CALL "ft_circle_new" USING FT-CIRCLE-NEW FT-STATUS
    CALL "ft_vector_shape_new" USING FT-VECTOR-SHAPE FT-STATUS
    MOVE FT-CIRCLE-NEW-RESULT TO FT-VECTOR-SHAPE-VALUE
    CALL "ft_vector_shape_push" USING FT-VECTOR-SHAPE FT-STATUS
    CALL "ft_vector_shape_push" USING FT-VECTOR-SHAPE FT-STATUS
    MOVE FT-VECTOR-SHAPE-SELF TO FT-TOTAL-AREA-SHAPES
    CALL "ft_total_area" USING FT-TOTAL-AREA FT-STATUS
    PERFORM EXPECT-OK
    IF FT-TOTAL-AREA-RESULT = 24 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "vector of values from C++" TO T-LABEL
    MOVE 3 TO FT-CIRCLES-COUNT
    CALL "ft_circles" USING FT-CIRCLES FT-STATUS
    MOVE FT-CIRCLES-RESULT TO FT-VECTOR-CIRCLE-SELF
    MOVE 3 TO FT-VECTOR-CIRCLE-INDEX
    CALL "ft_vector_circle_get" USING FT-VECTOR-CIRCLE FT-STATUS
    MOVE FT-VECTOR-CIRCLE-VALUE TO FT-CIRCLE-RADIUS-SELF
    CALL "ft_circle_radius" USING FT-CIRCLE-RADIUS FT-STATUS
    IF FT-CIRCLE-RADIUS-RESULT = 3 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "bytes" TO T-LABEL
    MOVE "AB" TO FT-BYTES-OF-TEXT
    CALL "ft_bytes_of" USING FT-BYTES-OF FT-STATUS
    MOVE FT-BYTES-OF-RESULT TO FT-BYTE-SUM-DATA
    CALL "ft_byte_sum" USING FT-BYTE-SUM FT-STATUS
    IF FT-BYTE-SUM-RESULT = 131 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF.

CALLBACKS.
    MOVE "COBOL callback" TO T-LABEL
    SET FT-APPLY-F TO ENTRY "SQUARE-IT"
    MOVE 3 TO FT-APPLY-X
    CALL "ft_apply" USING FT-APPLY FT-STATUS
    PERFORM EXPECT-OK
    IF FT-APPLY-RESULT = 9 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "failing callback" TO T-LABEL
    SET FT-APPLY-F TO ENTRY "REFUSE-IT"
    CALL "ft_apply" USING FT-APPLY FT-STATUS
    MOVE "callback" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "callback message" TO T-LABEL
    MOVE 0 TO T-I
    INSPECT FT-STATUS-MESSAGE TALLYING T-I FOR ALL "refused 3"
    IF T-I = 1 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "null callback" TO T-LABEL
    SET FT-APPLY-F TO NULL
    CALL "ft_apply" USING FT-APPLY FT-STATUS
    MOVE "native" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "C++ function value" TO T-LABEL
    MOVE 5 TO FT-ADDER-N
    CALL "ft_adder" USING FT-ADDER FT-STATUS
    MOVE FT-ADDER-RESULT TO FT-FN-INT-OF-INT-SELF
    MOVE 4 TO FT-FN-INT-OF-INT-ARG-1
    CALL "ft_fn_int_of_int_call" USING FT-FN-INT-OF-INT FT-STATUS
    PERFORM EXPECT-OK
    IF FT-FN-INT-OF-INT-RESULT = 9 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF.

OVERRIDES.
    MOVE "pure virtual must be set" TO T-LABEL
    CALL "ft_shape_extend" USING FT-SHAPE-EXTEND FT-STATUS
    MOVE "argument" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "COBOL subclass" TO T-LABEL
    SET FT-SHAPE-EXTEND-AREA TO ENTRY "MY-AREA"
    CALL "ft_shape_extend" USING FT-SHAPE-EXTEND FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-SHAPE-EXTEND-RESULT TO T-SHAPE FT-AREA-OF-SHAPE
    CALL "ft_area_of" USING FT-AREA-OF FT-STATUS
    PERFORM EXPECT-OK
    IF FT-AREA-OF-RESULT = 42 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "non-virtual method calls the override" TO T-LABEL
    MOVE T-SHAPE TO FT-SHAPE-TWICE-AREA-SELF
    CALL "ft_shape_twice_area" USING FT-SHAPE-TWICE-AREA FT-STATUS
    IF FT-SHAPE-TWICE-AREA-RESULT = 84 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "C++ method kept when not overridden" TO T-LABEL
    MOVE T-SHAPE TO FT-DESCRIBE-SHAPE
    CALL "ft_describe" USING FT-DESCRIBE FT-STATUS
    IF FT-DESCRIBE-RESULT(1:FT-DESCRIBE-RESULT-LENGTH) = "shape:7" PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "override with arguments and base call" TO T-LABEL
    SET FT-VISITOR-EXTEND-VISIT TO ENTRY "MY-VISIT"
    SET FT-VISITOR-EXTEND-FINISHED TO ENTRY "MY-FINISHED"
    CALL "ft_visitor_extend" USING FT-VISITOR-EXTEND FT-STATUS
    PERFORM EXPECT-OK
    MOVE FT-VISITOR-EXTEND-RESULT TO FT-RUN-VISITOR-VISITOR
    MOVE T-VEC TO FT-RUN-VISITOR-VALUES
    CALL "ft_run_visitor" USING FT-RUN-VISITOR FT-STATUS
    PERFORM EXPECT-OK
    *> T-VEC holds 8 2 14 5: visit adds 10 to each through the C++ base method.
    IF FT-RUN-VISITOR-RESULT = 69 AND VISITS = 5 PERFORM CHECK-PASSED ELSE PERFORM FAILED
        DISPLAY "  " FT-RUN-VISITOR-RESULT " " VISITS END-IF.

ERRORS.
    MOVE "C++ exception" TO T-LABEL
    MOVE -1 TO FT-CIRCLE-NEW-RADIUS
    CALL "ft_circle_new" USING FT-CIRCLE-NEW FT-STATUS
    MOVE "argument" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "closed handle" TO T-LABEL
    MOVE T-SHAPE TO FT-HANDLE-SELF
    CALL "ft_close" USING FT-HANDLE FT-STATUS
    CALL "ft_area_of" USING FT-AREA-OF FT-STATUS
    MOVE "closed" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "null handle" TO T-LABEL
    MOVE 0 TO FT-AREA-OF-SHAPE
    CALL "ft_area_of" USING FT-AREA-OF FT-STATUS
    MOVE "argument" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "long string result" TO T-LABEL
    MOVE "z" TO FT-REPEAT-C
    MOVE 300 TO FT-REPEAT-COUNT
    CALL "ft_repeat" USING FT-REPEAT FT-STATUS
    PERFORM EXPECT-OK
    IF FT-REPEAT-RESULT-LENGTH = 300 PERFORM CHECK-PASSED ELSE PERFORM FAILED END-IF
    MOVE "string too long" TO T-LABEL
    MOVE 1200 TO FT-REPEAT-COUNT
    CALL "ft_repeat" USING FT-REPEAT FT-STATUS
    MOVE "range" TO T-WANT-KIND
    PERFORM EXPECT-ERROR
    MOVE "invalid enum" TO T-LABEL
    MOVE 5 TO FT-MAKE-SHAPE-KIND
    CALL "ft_make_shape" USING FT-MAKE-SHAPE FT-STATUS
    MOVE "argument" TO T-WANT-KIND
    PERFORM EXPECT-ERROR.
END PROGRAM ROSETTA-COBOL-FULL.

