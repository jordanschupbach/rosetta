;;; Scheme names and conventions in the full Guile API (--guile-api full) over
;;; tests/guile_full_names.hpp: syntax and GOOPS names renamed with a trailing underscore, core
;;; procedures replaced with a fallback, ? and ! names, case, operators, flags, big integers,
;;; complex numbers, hash tables, policy exceptions and modules.
(use-modules (oop goops)
             (names)
             ((names stats) #:prefix stats:)
             (ice-9 documentation))

(define checks 0)
(define (check ok what)
  (set! checks (+ checks 1))
  (unless ok (error "check failed:" what)))
(define (fails key pattern thunk)
  (set! checks (+ checks 1))
  (let ((caught (catch #t (lambda () (thunk) #f) (lambda (k . args) (cons k args)))))
    (unless caught (error "expected an error containing" pattern))
    (unless (or (eq? key #t) (eq? (car caught) key)) (error "expected key" key 'got caught))
    (unless (string-contains (format #f "~a" (cdr caught)) pattern)
      (error "expected an error containing" pattern 'got caught))
    caught))
(define exports (resolve-interface '(names)))
(define (exported? name) (module-defined? exports name))

;;; --- Syntax keywords and GOOPS names get a trailing underscore --------------------------------
(check (= (define_ 1) 2) "define -> define_")
(check (= (lambda_ 1) 3) "lambda -> lambda_")
(check (= (if_ 1) 4) "if_ -> if_")
(check (string=? (quote_ "x") "'x'") "quote -> quote_")
(check (= (make_ 4) 8) "GOOPS make -> make_")
(check (not (exported? 'define)) "define stays syntax")
(check (not (exported? 'make)) "make stays GOOPS make")
(check (procedure? make) "GOOPS make still usable")
(check (= (formals 1 2 3) 6) "parameters named like syntax")
(check (string-contains (procedure-documentation formals) "LAMBDA_: Exact integer.") "renamed parameter documented")

;;; --- Core procedures are replaced and fall back to Guile's ------------------------------------
(check (string=? (list 3) "list of 3") "list: the C++ overload")
(check (equal? (list 1 2) '(1 2)) "list: Guile's list for other arguments")
(check (equal? (list) '()) "list: no arguments")
(check (= (length "abc") 30) "length: the C++ overload")
(check (= (length '(1 2 3)) 3) "length: Guile's length for a list")
(check (string=? (display 2.0) "<2>") "display: the C++ overload")
(check (string=? (with-output-to-string (lambda () (display "hi"))) "hi") "display: Guile's display")
(check (string=? (with-output-to-string (lambda () (display 'sym))) "sym") "display: Guile's display (symbol)")
(define words (make <words>))
(check (= (length words) 0) "length: method on a class")
(check (= (display words) 6) "display: method on a class")
(check (equal? (reverse '(1 2 3)) '(3 2 1)) "reverse: Guile's reverse")
(check (= (reverse words) 12) "reverse: method on a class")
(check (string-contains (procedure-documentation length) "Guile's length") "fallback documented")

;;; --- Classes named like GOOPS classes --------------------------------------------------------
(check (= (size (make <string_>)) 1) "<string> -> <string_>")
(check (eq? <string> (class-of "x")) "GOOPS <string> untouched")
(check (= (id (make <class_>)) 4) "<class> -> <class_>")
(check (string=? (text (make-string_)) "s") "make-<class> of a renamed class")

;;; --- Predicates, mutators and case -----------------------------------------------------------
(check (empty? words) "is_empty -> empty?")
(check (not (has-name? words)) "has_name -> has-name?")
(set-name! words "w")
(check (has-name? words) "set_name -> set-name!")
(check (matches? words "w") "bool with arguments -> matches?")
(check (string=? (get-name words) "w") "get_name -> get-name")
(check (= (initialize_ words) 7) "initialize -> initialize_")
(check (= (class-name_ words) 8) "class_name -> class-name_")
(check (eq? (class-name <words>) '<words>) "GOOPS class-name untouched")
(check (= (words-create) 9) "static method -> words-create")
(check (= (camel-case words) 10) "camelCase -> camel-case")
(check (= (http-server words) 11) "HTTPServer -> http-server")
(check (string-contains (procedure-documentation set-name!) "Sets the name.") "method docstring")

;;; --- Operators -------------------------------------------------------------------------------
(define a (make <bits> 12))
(define b (make <bits> 10))
(check (= (value (bit-and a b)) 8) "operator& -> bit-and")
(check (= (value (bit-or a b)) 14) "operator| -> bit-or")
(check (= (value (bit-xor a b)) 6) "operator^ -> bit-xor")
(check (= (value (bit-not (make <bits> 0))) 4294967295) "operator~ -> bit-not")
(check (= (value (shift-left a 1)) 24) "operator<< -> shift-left")
(check (= (value (shift-right a 2)) 3) "operator>> -> shift-right")
(check (= (value (/ a b)) 1) "operator/ extends /")
(check (= (value (modulo a b)) 2) "operator% extends modulo")
(fails 'names-invalid-argument "division by zero bits" (lambda () (/ a (make <bits> 0))))
(check (< b a) "operator< extends <")
(check (<= b a) "operator<= extends <=")
(check (> a b) "operator> extends >")
(check (>= a a) "operator>= extends >=")
(check (equal? a (make <bits> 12)) "operator== extends equal?")
(check (= (call a 1) 13) "operator() -> call")
(check (= (/ 6 3) 2) "core / still divides")
(check (< 1 2) "core < still compares")
(check (= (modulo 7 3) 1) "core modulo still works")
(define row (make <row>))
(ref-set! row 1 5)
(check (= (ref row 1) 5) "mutable operator[] -> ref and ref-set!")
(check (equal? (cells row) '(0 5 0)) "ref-set! writes the C++ element")
(fails 'names-out-of-range "Row index" (lambda () (ref row 3)))

;;; --- Enumerations ----------------------------------------------------------------------------
(check (equal? (case-values) '(None none mixed-case)) "enumerators differing in case keep distinct symbols")
(check (= (case->integer 'none) 1) "case-sensitive enumerator symbol")
(check (= (permission-bits 'write) 2) "flag enum from a symbol")
(check (= (permission-bits '(read execute)) 5) "flag enum from a list of symbols")
(check (= (permission-bits 6) 6) "flag enum from an integer")
(check (= (all-permissions) 7) "flag enum results are integers")
(check (equal? (permission-values) '(read write execute)) "flag enum values")

;;; --- Numbers, containers and text ------------------------------------------------------------
(check (= (big (- (expt 2 62))) (- (expt 2 62))) "int64 round trip")
(check (= (ubig (- (expt 2 64) 1)) (- (expt 2 64) 1)) "uint64 maximum (a bignum)")
(fails 'out-of-range "outside the range" (lambda () (ubig (expt 2 64))))
(fails 'out-of-range "outside the range" (lambda () (ubig -1)))
(fails 'out-of-range "outside the range" (lambda () (big (expt 2 63))))
(check (= (rotate 1.0+0.0i) 0.0+1.0i) "complex argument and result")
(check (= (rotate 2) 0.0+2.0i) "real converts to complex")
(check (= (total '(("a" . 1) ("b" . 2))) 3) "map from an alist")
(define table (make-hash-table))
(hash-set! table "x" 4)
(hash-set! table "y" 5)
(check (= (total table) 9) "map from a hash table")
(check (equal? (counts) '(("a" . 1))) "unordered_map result is an alist")
(check (equal? (unique '(3 1 3 2)) '(1 2 3)) "set result is a list")
(check (equal? (triple) '(1 "two" 3.0)) "tuple result is a list")
(check (= (either #f) 5) "variant result (int)")
(check (string=? (either #t) "text") "variant result (string)")
(check (string=? (describe-either 1) "int") "variant argument (int)")
(check (string=? (describe-either "s") "string") "variant argument (string)")
(check (string=? (c-text #f) "c") "const char* result")
(check (not (c-text #t)) "null const char* is #f")
(check (= (hex-default) 256) "hexadecimal and boolean literal defaults")
(check (= (hex-default 1 2.0 #f) 0) "explicit arguments")
(check (= (lookup '(("k" . 3)) "k") 3) "lookup")
(fails 'names-key-error "" (lambda () (lookup '() "missing")))
(check (names-error? (catch #t (lambda () (lookup '() "missing")) (lambda (k . args) k))) "policy exception key")

;;; --- Policy modules --------------------------------------------------------------------------
(check (= (stats:mean '(1.0 2.0 3.0)) 2.0) "submodule function")
(check (= (stats:max '(1.0 5.0 2.0)) 5.0) "submodule function replacing a core procedure")
(check (= (stats:max 1 7 3) 7) "submodule fallback to Guile's max")
(check (= (max 1 2) 2) "core max untouched outside the submodule")
(check (string-contains (procedure-documentation stats:mean) "(names stats)") "submodule docstring")

(format #t "Guile full names passed (~a checks)\n" checks)
