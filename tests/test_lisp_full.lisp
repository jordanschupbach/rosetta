;;;; Full Common Lisp API (--lisp-api full) on the library-shaped example shared with the
;;;; Python, R6 and Lua backends. Argument: the generated ASDF system file (features.asd).
(require "asdf")
(let ((system (car (last sb-ext:*posix-argv*))))
  (asdf:load-asd (merge-pathnames system (uiop:getcwd)))
  (asdf:load-system "features"))

(defpackage #:features-test (:use #:common-lisp))
(in-package #:features-test)

(defvar *checks* 0)
(defmacro check (form &optional message)
  `(progn (incf *checks*)
          (unless ,form (error "check failed: ~A~@[ (~A)~]" ',form ,message))))
(defun fails (thunk pattern)
  (incf *checks*)
  (let ((message (handler-case (progn (funcall thunk) nil)
                   (error (condition) (or (ignore-errors (princ-to-string condition)) "?")))))
    (unless message (error "expected an error containing ~S, got none" pattern))
    (unless (search pattern message) (error "expected an error containing ~S, got: ~A" pattern message))))
(defun gc () (sb-ext:gc :full t) (sb-ext:gc :full t) (sleep 0.05))

;;; Classes, inheritance and virtual dispatch.
(defvar *c1* (ft:make-circle 2))
(check (and (= (ft:area *c1*) 12) (equal (ft:name *c1*) "circle") (= (ft:twice-area *c1*) 24) (= (ft:radius *c1*) 2)))
(check (search "CIRCLE" (prin1-to-string *c1*)))
(check (typep *c1* 'ft:shape))
(fails (lambda () (ft:make-circle -1)) "negative radius")
(fails (lambda () (make-instance 'ft:shape)) "abstract")
(defvar *s* (ft:make-square))
(check (and (= (ft:side *s*) 1) (= (ft:area *s*) 1)))
(setf (ft:side *s*) 3)
(check (and (= (ft:area *s*) 9) (= (ft:area (ft:make-square 2)) 4)))
(fails (lambda () (setf (ft:side *s*) "wide")) "field side")
(check (and (= (ft:area-of *s*) 9) (equal (ft:describe *c1*) "circle:0")))
;; Enums are keywords; arguments also accept integers.
(check (and (eq (ft:kind *c1*) :circle) (eq (ft:kind *s*) :square)))
(check (and (ft:filled :solid) (not (ft:filled :none)) (ft:filled 1)))
(fails (lambda () (ft:filled :bogus)) "unknown enumerator")
(check (typep :custom 'ft:kind))
(check (and (= ft:+shape-sides-unknown+ -1) (< (abs (- ft:+golden+ 1.618d0)) 1d-12)))

;;; Most-derived results, ownership transfer and shared ownership.
(defvar *made* (ft:make-shape :circle 1))
(check (and (typep *made* 'ft:circle) (= (ft:radius *made*) 1)))
(defvar *canvas* (ft:make-canvas))
(ft:add *canvas* (ft:make-shape :square 2))
(ft:share *canvas* (ft:shared-square 3))
(defvar *transferred* (ft:make-circle 1))
(ft:add *canvas* *transferred*)
(fails (lambda () (ft:area *transferred*)) "closed")
(check (and (= (ft:size *canvas*) 3) (= (ft:total *canvas*) (+ 4 9 3))))
(let ((first (ft:at *canvas* 0)))
  (check (and (typep first 'ft:square) (= (ft:area first) 4))))
(let ((shared (ft:shared-square 2)))
  (ft:share *canvas* shared)
  (check (and (= (ft:area shared) 4) (= (ft:total *canvas*) 20)))
  (check (= (ft:total-area (list (ft:make-circle 1) shared)) 7)))

;;; Overload resolution by Lisp type (integer vs float).
(check (and (equal (ft:pick 1) "int") (equal (ft:pick 1.5d0) "double") (equal (ft:pick 2.0) "double")
            (equal (ft:pick "x") "string")))
(check (and (equal (ft:pick (list 1 2)) "vector") (equal (ft:pick *s*) "shape")))
(check (and (= (ft:add 1) 111) (= (ft:add 1 2) 103) (= (ft:add 1 2 3) 6)))
(fails (lambda () (ft:add 1 2 3 4)) "supported signatures")
(fails (lambda () (ft:add "x")) "argument 'a'")

;;; Containers: sequences in, vectors out; hash tables; pairs as lists.
(let ((counts (ft:count-words (list "a" "b" "a"))))
  (check (and (hash-table-p counts) (= (gethash "a" counts) 2) (= (gethash "b" counts) 1))))
(check (equalp (ft:min-max (vector 3 1 2)) '(1 3)))
(fails (lambda () (ft:min-max nil)) "empty input")
(check (and (eql (ft:find (list 5 7) 7) 1) (null (ft:find (list 5 7) 9)) (eql (ft:find (list 5d0 7d0) 7) 1)))
(let ((tr (ft:transpose '((1 2 3) (4 5 6)))))
  (check (and (= (length tr) 3) (equalp (aref tr 0) #(1 4)))))
(check (and (= (ft:byte-sum (list 1 2 250)) 253) (equalp (ft:bytes-of "AZ") #(65 90))))
(let ((cs (ft:circles 3)))
  (check (and (= (length cs) 3) (= (ft:radius (aref cs 2)) 3))))
(check (and (equal (ft:repeat "z" 3) "zzz") (equal (ft:initial "hello") "h")))
;; Mutable reference parameters update a ref cell; plain sequences are passed by value.
(let ((values (ft:ref (list 1 2))))
  (ft:scale values 3)
  (check (equalp (ft:ref-value values) #(3 6))))
(let ((plain (list 1 2)))
  (ft:scale plain 3)
  (check (equal plain '(1 2))))
(fails (lambda () (ft:scale (ft:ref "x") 2)) "argument 'values'")
(fails (lambda () (ft:repeat "z" -1)) "negative count")
(fails (lambda () (ft:repeat "z" (expt 2 40))) "argument 'count'")
(check (equal (ft:defaults) "x*1-1.500000"))
(check (search "Must override: area." (documentation 'ft:shape 'type)) "overridable methods named")
(check (search "(weight 0.5d0)" (documentation 'ft:defaults 'function)) "double defaults in double-float syntax")

;;; Callbacks both ways.
(check (= (ft:apply (lambda (x) (* x 2)) 21) 42))
(fails (lambda () (ft:apply (lambda (x) (declare (ignore x)) (error "inside callback")) 1)) "inside callback")
;; The Lisp condition comes back as itself.
(check (eq (handler-case (ft:apply (lambda (x) (declare (ignore x)) (error 'division-by-zero)) 1)
             (division-by-zero () :caught))
           :caught))
(fails (lambda () (ft:apply (lambda (x) (declare (ignore x)) "text") 1)) "does not convert")
(let ((plus (ft:adder 40)))
  (check (= (funcall plus 2) 42))
  (check (= (ft:apply (ft:adder 1) 3) 4)))
;; Callbacks from another Lisp thread.
(check (= (sb-thread:join-thread (sb-thread:make-thread (lambda () (ft:apply (lambda (x) (1+ x)) 1)))) 2))

;;; Value type operators, chaining and borrowed references.
(let* ((v (ft:make-vec2 1 2))
       (w (ft:+ v (ft:make-vec2 3 4))))
  (check (and (= (ft:x w) 4) (= (ft:y w) 6) (= (ft:y (ft:* v 2)) 4) (= (ft:x (ft:- v)) -1) (= (ft:x (ft:- v w)) -3)))
  (check (and (ft:= v (ft:make-vec2 1 2)) (not (ft:= v w))))
  (check (and (= (ft:aref v 1) 2) (= (ft:inner v (ft:make-vec2 1 1)) 3)))
  (check (and (= (ft:+ 1 2) 3) (= (ft:* 2 3) 6)))
  (fails (lambda () (ft:aref v 2)) "Vec2 index")
  (let ((chained (ft:set-y (ft:set-x v 10) 20)))
    (check (and (eq chained v) (= (ft:x v) 10) (= (ft:y v) 20)))))
(let ((seg (ft:make-segment)))
  (setf (ft:end seg) (ft:make-vec2 3 4))
  (check (= (ft:length2 seg) 25))
  (let ((start (ft:first seg)))
    (setf (ft:x start) 3)
    (check (and (= (ft:x (ft:start seg)) 3) (= (ft:length2 seg) 16))))
  (setf (ft:y (ft:start seg)) 4)
  (check (= (ft:length2 seg) 0)))
(check (= (ft:y (ft:clone (ft:make-vec2 1 2))) 2))
(check (= (ft:sum (list (ft:make-vec2 1 2) (ft:make-vec2 3 4))) 10))
(let ((held (ft:first (ft:make-segment))))
  (gc)
  (check (= (ft:x held) 0)))

;;; Templates, extensions, qualified names and copy types.
(let ((stack (ft:make-int-stack)))
  (ft:push stack 1) (ft:push stack 2)
  (check (and (= (ft:size stack) 2) (equalp (ft:items stack) #(1 2)) (= (ft:pop stack) 2)))
  (fails (lambda () (ft:push stack 2.5)) "argument 'value'"))
(check (and (= (ft:clamp-int 42) 10) (= (ft:clamp-int 3 5) 3) (= (ft:clamp-real 2.5) 2.5)))
(check (and (equal (ft:label *c1*) "#circle") (equal (ft:label *c1* "@") "@circle") (= (ft:radius (ft:circle-unit)) 1)))
(check (and (= (ft:features--legacy--version) 2) (= (ft:id (ft:make-features--legacy--tag)) 7)))
(check (typep :off 'ft:features--legacy--mode))
(check (and (eq (find-class 'ft:features--legacy--circle) (find-class 'ft:circle)) (typep :square 'ft:features--legacy--kind)))
(check (= (ft:diameter (ft:make-circle 2)) 4))
(check (= (ft:features--legacy--area-of (ft:make-square)) 1))
(let* ((ledger (ft:make-ledger))
       (copy (ft:latest ledger)))
  (setf (ft:value copy) 5)
  (check (= (ft:value (ft:stamp ledger)) 1)))
(let ((aim (ft:make-aim)))
  (setf (ft:x (ft:origin aim)) 2)
  (check (= (ft:x (ft:point (ft:target aim))) 2))
  (fails (lambda () (setf (ft:point (ft:target aim)) (ft:make-vec2))) "read-only"))

;;; Errors, closing and garbage collection.
(fails (lambda () (ft:area-of 1)) "argument 'shape': expected shape, got integer")
(fails (lambda () (ft:area *c1* 1)) "incompatible arguments")
(check (eq (handler-case (ft:area-of 1) (ft:native-error (e) (ft:native-error-kind e))) :binding))
(check (eq (handler-case (ft:make-circle -1) (ft:native-error (e) (ft:native-error-kind e))) :invalid-argument))
(let ((x (ft:make-circle 1)))
  (check (= (ft:area x) 3))
  (close x)
  (fails (lambda () (ft:area x)) "closed")
  (close x))
(ft:with-object (x (ft:make-circle 1))
  (check (= (ft:area x) 3)))
(dotimes (i 200) (let ((tmp (ft:make-shape :square (1+ i)))) (check (= (ft:area tmp) (* (1+ i) (1+ i))))))
(gc)

;;; Directors: Lisp subclasses implement C++ virtual methods.
(defclass triangle (ft:shape)
  ((base :initarg :base :reader base) (height :initarg :height :reader height)))
(ft:define-override ft:area ((self triangle)) (/ (* (base self) (height self)) 2))
(ft:define-override ft:name ((self triangle)) "triangle")
(let ((tr (make-instance 'triangle :base 4 :height 3)))
  (check (and (= (ft:area tr) 6) (= (ft:area-of tr) 6) (= (ft:twice-area tr) 12) (equal (ft:describe tr) "triangle:7")))
  (check (and (= (ft:total-area (list tr (ft:make-circle 1) (ft:make-square 2))) 13) (equal (ft:label tr "@") "@triangle"))))
(defclass incomplete (ft:shape) ())
(fails (lambda () (ft:area-of (make-instance 'incomplete))) "pure virtual method")
(defclass failing (ft:shape) ())
(ft:define-override ft:area ((self failing)) (error "from Lisp"))
(fails (lambda () (ft:area-of (make-instance 'failing))) "from Lisp")
(defclass wrong (ft:shape) ())
(ft:define-override ft:area ((self wrong)) "not a number")
(fails (lambda () (ft:area-of (make-instance 'wrong))) "does not convert")
;; CALL-NEXT-METHOD runs the native implementation rather than dispatching back to the override.
(defclass loud (ft:circle) ())
(ft:define-override ft:name ((self loud)) (string-upcase (call-next-method)))
(check (and (equal (ft:describe (make-instance 'loud :args '(1))) "CIRCLE:0") (= (ft:area (make-instance 'loud :args '(2))) 12)))
;; Subclasses of subclasses.
(defclass louder (loud) ())
(check (equal (ft:describe (make-instance 'louder :args '(1))) "CIRCLE:0"))
;; Ownership transfer keeps the Lisp object alive; the same Lisp object comes back.
(defclass unit (ft:shape) ((tag :initform nil :accessor tag)))
(ft:define-override ft:area ((self unit)) 1)
(setf *canvas* (ft:make-canvas))
(let ((u (make-instance 'unit)))
  (setf (tag u) "kept")
  (ft:add *canvas* u)
  (check (= (ft:area u) 1)))
(gc)
(ft:share *canvas* (ft:make-square 2))
(check (and (= (ft:total *canvas*) 5) (= (ft:size *canvas*) 2)))
(let ((back (ft:at *canvas* 0)))
  (check (and (typep back 'unit) (equal (tag back) "kept") (eq back (ft:at *canvas* 0)))))
(ft:clear *canvas*)
(gc)
(let ((shared-unit (make-instance 'unit)))
  (ft:share *canvas* shared-unit))
(gc)
(check (= (ft:total *canvas*) 1))
(ft:clear *canvas*)
(gc)
;; Callback interfaces with a native default implementation.
(defclass summer (ft:visitor) ((seen :initform nil :accessor seen)))
(ft:define-override ft:visit ((self summer) value) (* value 10))
(ft:define-override ft:finished ((self summer) values) (setf (seen self) values))
(let ((summer (make-instance 'summer)))
  (check (and (= (ft:run-visitor summer (list 1 2)) 30) (equalp (seen summer) #(1 2)))))
(check (= (ft:run-visitor (ft:make-visitor) (list 1 2)) 3))

;;; Docstrings carry the C++ documentation (DESCRIBE, editors).
(check (search "Also a function" (documentation 'ft:add 'function)))
;; add is also a method of canvas: the function is the generic function's method on T.
(let ((doc (documentation (find-method #'ft:add '() (list (find-class t))) t)))
  (check (search "Adds three integers, Socha & Dorigo style." doc) "add brief")
  (check (search "(add a &optional (b 10) (c 100)) → integer" doc) "add signature")
  (check (search "a  integer  first term" doc) "parameter a")
  (check (search "→ the sum" doc) "returns"))
(check (search "Methods:" (documentation 'ft:area 'function)))
(let ((method-doc (documentation (find-method #'ft:area '() (list (find-class 'ft:circle))) t)))
  (check (search "(area circle) → double-float" method-doc) "method signature"))
(check (search "(make-circle radius) → circle" (documentation 'ft:circle 'type)) "class constructors")
(check (search "x  double-float  Horizontal component." (documentation 'ft:vec2 'type)) "fields")
(check (search "Values: :circle (0), :square (1), :custom (7)" (documentation 'ft:kind 'type)) "enum")
(check (search "(make-instance 'shape" (documentation 'ft:shape 'type)) "make-shape is a function")
(check (search "&optional (kind :square)" (documentation 'ft:defaults 'function)) "enum default")
(check (search "values  (vector double-float)" (documentation 'ft:run-visitor 'function)) "sequence type")
(check (search "shapes  (vector shape)" (documentation 'ft:total-area 'function)) "class sequence type")
(check (search "(function (double-float) double-float)" (documentation 'ft:apply 'function)) "callback type")
;; Policy modules: features::data functions live in their own package FEATURES.DATA (nickname FT.DATA).
(check (eq (find-package "FT.DATA") (find-package "FEATURES.DATA")) "submodule package and nickname")
(let ((u (ft.data:unit)))
  (check (and (typep u 'ft:vec2) (= (ft:x u) 1) (= (ft:y u) 0)) "submodule result"))
(check (and (= (ft.data:scaled 3) 6) (= (ft.data:scaled 2.5d0) 6.25d0)) "submodule overloads")
(check (and (equal (ft.data:repeat "ab") "abab") (equal (ft:repeat "x" 3) "xxx")) "submodule names are separate")
(check (not (eq (nth-value 1 (find-symbol "SCALED" "FEATURES")) :external)) "nothing leaks to the main package")
(check (search "Mapped by the policy's modules" (or (documentation 'ft.data:unit 'function) "")) "submodule docs")
(gc)
(format t "Common Lisp full API passed (~D checks)~%" *checks*)
