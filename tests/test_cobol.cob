*> Runtime tests for the generated COBOL bindings (free format). CTest runs
*> one family, named by the command-line argument.
IDENTIFICATION DIVISION.
PROGRAM-ID. ROSETTA-COBOL-TESTS.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "cobol_demo.cpy".
COPY "cobol_verify.cpy".
COPY "cobol_names.cpy".
01 T-FAMILY        PIC X(20).
01 T-FAILURES      PIC 9(4) VALUE 0.
01 T-TEST-LABEL    PIC X(40).
01 T-WANT-KIND     PIC X(10).
01 T-WANT-TEXT     PIC X(80).
01 T-HITS          PIC 9(4).
01 T-ROUND         PIC 9(4).
01 T-ORDER         PIC 9.
01 T-POPPED        PIC X(3).
01 T-EXPECTED      PIC X(12) VALUE "mzaazmzmaamz".
01 T-COUNTER       USAGE BINARY-DOUBLE UNSIGNED.
01 T-SERIES        USAGE BINARY-DOUBLE UNSIGNED.
01 T-WORKLIST      USAGE BINARY-DOUBLE UNSIGNED.
01 T-TASK          USAGE BINARY-DOUBLE UNSIGNED.
01 T-POINT         USAGE BINARY-DOUBLE UNSIGNED.
01 T-UTF8-TEXT     PIC X(10) VALUE "世界😀".

PROCEDURE DIVISION.
    ACCEPT T-FAMILY FROM COMMAND-LINE
    EVALUATE T-FAMILY
        WHEN "scalars"  PERFORM SCALARS
        WHEN "names"    PERFORM NAMES
        WHEN "objects"  PERFORM OBJECTS
        WHEN "features" PERFORM FEATURES
        WHEN "exit"     PERFORM LEAVE-WORKER
        WHEN OTHER      MOVE "unknown family" TO T-TEST-LABEL PERFORM FAILED
    END-EVALUATE
    IF T-FAILURES = 0
        DISPLAY "ROSETTA PASS " FUNCTION TRIM(T-FAMILY)
    END-IF
    MOVE 0 TO RETURN-CODE
    STOP RUN.

FAILED.
    ADD 1 TO T-FAILURES
    DISPLAY "FAIL " FUNCTION TRIM(T-TEST-LABEL).

EXPECT-OK.
    IF NOT COBOL-DEMO-STATUS-OK OR RETURN-CODE NOT = 0
        PERFORM FAILED
        DISPLAY "  " FUNCTION TRIM(COBOL-DEMO-STATUS-KIND) ": "
            COBOL-DEMO-STATUS-MESSAGE(1:COBOL-DEMO-STATUS-LENGTH)
    END-IF.

*> The last call must have failed with T-WANT-KIND, a message containing
*> T-WANT-TEXT, and the matching RETURN-CODE.
EXPECT-ERROR.
    MOVE 0 TO T-HITS
    IF COBOL-DEMO-STATUS-LENGTH > 0
        INSPECT COBOL-DEMO-STATUS-MESSAGE(1:COBOL-DEMO-STATUS-LENGTH)
            TALLYING T-HITS FOR ALL T-WANT-TEXT(1:FUNCTION LENGTH(FUNCTION TRIM(T-WANT-TEXT)))
    END-IF
    IF COBOL-DEMO-STATUS-OK OR COBOL-DEMO-STATUS-KIND NOT = T-WANT-KIND OR T-HITS = 0
            OR RETURN-CODE NOT = COBOL-DEMO-STATUS-CODE
        PERFORM FAILED
        DISPLAY "  got " FUNCTION TRIM(COBOL-DEMO-STATUS-KIND) " (" RETURN-CODE "): "
            COBOL-DEMO-STATUS-MESSAGE(1:FUNCTION MAX(COBOL-DEMO-STATUS-LENGTH 1))
    END-IF.

SCALARS.
    MOVE "schar" TO T-TEST-LABEL
    MOVE -128 TO COBOL-VERIFY-ECHO-SCHAR-VALUE
    CALL "cobol_verify_echo_schar" USING COBOL-VERIFY-ECHO-SCHAR COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-SCHAR-RESULT NOT = -128 PERFORM FAILED END-IF
    MOVE "uchar" TO T-TEST-LABEL
    MOVE 255 TO COBOL-VERIFY-ECHO-UCHAR-VALUE
    CALL "cobol_verify_echo_uchar" USING COBOL-VERIFY-ECHO-UCHAR COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-UCHAR-RESULT NOT = 255 PERFORM FAILED END-IF
    MOVE "char" TO T-TEST-LABEL
    MOVE X"FF" TO COBOL-VERIFY-ECHO-CHAR-VALUE
    CALL "cobol_verify_echo_char" USING COBOL-VERIFY-ECHO-CHAR COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-CHAR-RESULT NOT = X"FF" PERFORM FAILED END-IF
    MOVE "short" TO T-TEST-LABEL
    MOVE -32768 TO COBOL-VERIFY-ECHO-SHORT-VALUE
    CALL "cobol_verify_echo_short" USING COBOL-VERIFY-ECHO-SHORT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-SHORT-RESULT NOT = -32768 PERFORM FAILED END-IF
    MOVE "ushort" TO T-TEST-LABEL
    MOVE 65535 TO COBOL-VERIFY-ECHO-USHORT-VALUE
    CALL "cobol_verify_echo_ushort" USING COBOL-VERIFY-ECHO-USHORT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-USHORT-RESULT NOT = 65535 PERFORM FAILED END-IF
    MOVE "int" TO T-TEST-LABEL
    MOVE -2147483648 TO COBOL-VERIFY-ECHO-INT-VALUE
    CALL "cobol_verify_echo_int" USING COBOL-VERIFY-ECHO-INT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-INT-RESULT NOT = -2147483648 PERFORM FAILED END-IF
    MOVE "uint" TO T-TEST-LABEL
    MOVE 4294967295 TO COBOL-VERIFY-ECHO-UINT-VALUE
    CALL "cobol_verify_echo_uint" USING COBOL-VERIFY-ECHO-UINT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-UINT-RESULT NOT = 4294967295 PERFORM FAILED END-IF
    MOVE "long" TO T-TEST-LABEL
    MOVE -9223372036854775808 TO COBOL-VERIFY-ECHO-LONG-VALUE
    CALL "cobol_verify_echo_long" USING COBOL-VERIFY-ECHO-LONG COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-LONG-RESULT NOT = -9223372036854775808 PERFORM FAILED END-IF
    MOVE "ll" TO T-TEST-LABEL
    MOVE 9223372036854775807 TO COBOL-VERIFY-ECHO-LL-VALUE
    CALL "cobol_verify_echo_ll" USING COBOL-VERIFY-ECHO-LL COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-LL-RESULT NOT = 9223372036854775807 PERFORM FAILED END-IF
    MOVE "ulong" TO T-TEST-LABEL
    MOVE 18446744073709551615 TO COBOL-VERIFY-ECHO-ULONG-VALUE
    CALL "cobol_verify_echo_ulong" USING COBOL-VERIFY-ECHO-ULONG COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-ULONG-RESULT NOT = 18446744073709551615 PERFORM FAILED END-IF
    MOVE "ull" TO T-TEST-LABEL
    MOVE 18446744073709551615 TO COBOL-VERIFY-ECHO-ULL-VALUE
    CALL "cobol_verify_echo_ull" USING COBOL-VERIFY-ECHO-ULL COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-ULL-RESULT NOT = 18446744073709551615 PERFORM FAILED END-IF
    MOVE "too large" TO T-TEST-LABEL
    CALL "cobol_demo_too_large" USING COBOL-DEMO-TOO-LARGE COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-DEMO-TOO-LARGE-RESULT NOT = 9007199254740993 PERFORM FAILED END-IF
    MOVE "add" TO T-TEST-LABEL
    MOVE 20 TO COBOL-DEMO-ADD-A
    MOVE 22 TO COBOL-DEMO-ADD-B
    CALL "cobol_demo_add" USING COBOL-DEMO-ADD COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-DEMO-ADD-RESULT NOT = 42 PERFORM FAILED END-IF
    MOVE "float" TO T-TEST-LABEL
    MOVE 1.25 TO COBOL-VERIFY-ECHO-FLOAT-VALUE
    CALL "cobol_verify_echo_float" USING COBOL-VERIFY-ECHO-FLOAT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-FLOAT-RESULT NOT = 1.25 PERFORM FAILED END-IF
    MOVE "double" TO T-TEST-LABEL
    MOVE 2.5E+100 TO COBOL-VERIFY-ECHO-DOUBLE-VALUE
    CALL "cobol_verify_echo_double" USING COBOL-VERIFY-ECHO-DOUBLE COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-DOUBLE-RESULT NOT = COBOL-VERIFY-ECHO-DOUBLE-VALUE PERFORM FAILED END-IF
    MOVE "half" TO T-TEST-LABEL
    MOVE 3 TO COBOL-DEMO-HALF-VALUE
    CALL "cobol_demo_half" USING COBOL-DEMO-HALF COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-DEMO-HALF-RESULT NOT = 1.5 PERFORM FAILED END-IF
    MOVE "nonfinite" TO T-TEST-LABEL
    CALL "cobol_verify_nonfinite_result" USING COBOL-VERIFY-NONFINITE-RESULT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    MOVE "negate" TO T-TEST-LABEL
    MOVE 1 TO COBOL-DEMO-NEGATE-VALUE
    CALL "cobol_demo_negate" USING COBOL-DEMO-NEGATE COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-DEMO-NEGATE-RESULT NOT = 0 PERFORM FAILED END-IF
    MOVE "bool" TO T-TEST-LABEL
    MOVE 2 TO COBOL-VERIFY-ECHO-BOOL-VALUE
    CALL "cobol_verify_echo_bool" USING COBOL-VERIFY-ECHO-BOOL COBOL-DEMO-STATUS
    MOVE "argument" TO T-WANT-KIND
    MOVE "expected a boolean (0 or 1)" TO T-WANT-TEXT
    PERFORM EXPECT-ERROR
    *> Strings: -1 trims trailing spaces; a length sends exactly that many bytes.
    MOVE "trimmed string" TO T-TEST-LABEL
    MOVE "world" TO COBOL-VERIFY-ECHO-STRING-VALUE
    MOVE -1 TO COBOL-VERIFY-ECHO-STRING-VALUE-LENGTH
    CALL "cobol_verify_echo_string" USING COBOL-VERIFY-ECHO-STRING COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-STRING-RESULT-LENGTH NOT = 5 OR COBOL-VERIFY-ECHO-STRING-RESULT NOT = "world"
        PERFORM FAILED
    END-IF
    MOVE "empty string" TO T-TEST-LABEL
    MOVE 0 TO COBOL-VERIFY-ECHO-STRING-VALUE-LENGTH
    CALL "cobol_verify_echo_string" USING COBOL-VERIFY-ECHO-STRING COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-STRING-RESULT-LENGTH NOT = 0 OR COBOL-VERIFY-ECHO-STRING-RESULT NOT = SPACES
        PERFORM FAILED
    END-IF
    MOVE "trailing spaces" TO T-TEST-LABEL
    MOVE "ab" TO COBOL-VERIFY-ECHO-STRING-VALUE
    MOVE 4 TO COBOL-VERIFY-ECHO-STRING-VALUE-LENGTH
    CALL "cobol_verify_echo_string" USING COBOL-VERIFY-ECHO-STRING COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-STRING-RESULT-LENGTH NOT = 4 PERFORM FAILED END-IF
    MOVE "UTF-8 string" TO T-TEST-LABEL
    MOVE T-UTF8-TEXT TO COBOL-VERIFY-ECHO-STRING-VALUE
    MOVE -1 TO COBOL-VERIFY-ECHO-STRING-VALUE-LENGTH
    CALL "cobol_verify_echo_string" USING COBOL-VERIFY-ECHO-STRING COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-STRING-RESULT-LENGTH NOT = 10 OR COBOL-VERIFY-ECHO-STRING-RESULT(1:10) NOT = T-UTF8-TEXT
        PERFORM FAILED
    END-IF
    MOVE "NUL string" TO T-TEST-LABEL
    MOVE SPACES TO COBOL-VERIFY-ECHO-STRING-VALUE
    MOVE "a" TO COBOL-VERIFY-ECHO-STRING-VALUE(1:1)
    MOVE X"00" TO COBOL-VERIFY-ECHO-STRING-VALUE(2:1)
    MOVE "b" TO COBOL-VERIFY-ECHO-STRING-VALUE(3:1)
    MOVE 3 TO COBOL-VERIFY-ECHO-STRING-VALUE-LENGTH
    CALL "cobol_verify_echo_string" USING COBOL-VERIFY-ECHO-STRING COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-STRING-RESULT-LENGTH NOT = 3
            OR COBOL-VERIFY-ECHO-STRING-RESULT(1:3) NOT = COBOL-VERIFY-ECHO-STRING-VALUE(1:3)
        PERFORM FAILED
    END-IF
    MOVE "full string" TO T-TEST-LABEL
    MOVE ALL "x" TO COBOL-VERIFY-ECHO-STRING-VALUE
    MOVE 256 TO COBOL-VERIFY-ECHO-STRING-VALUE-LENGTH
    CALL "cobol_verify_echo_string" USING COBOL-VERIFY-ECHO-STRING COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ECHO-STRING-RESULT-LENGTH NOT = 256 OR COBOL-VERIFY-ECHO-STRING-RESULT NOT = ALL "x"
        PERFORM FAILED
    END-IF
    MOVE "string length" TO T-TEST-LABEL
    MOVE 300 TO COBOL-VERIFY-ECHO-STRING-VALUE-LENGTH
    CALL "cobol_verify_echo_string" USING COBOL-VERIFY-ECHO-STRING COBOL-DEMO-STATUS
    MOVE "argument" TO T-WANT-KIND
    MOVE "string length outside its 256-byte field" TO T-WANT-TEXT
    PERFORM EXPECT-ERROR
    MOVE "embedded nul" TO T-TEST-LABEL
    CALL "cobol_verify_embedded_nul" USING COBOL-VERIFY-EMBEDDED-NUL COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-EMBEDDED-NUL-RESULT-LENGTH NOT = 3 OR COBOL-VERIFY-EMBEDDED-NUL-RESULT(2:1) NOT = X"00"
        PERFORM FAILED
    END-IF
    MOVE "greet" TO T-TEST-LABEL
    MOVE "COBOL" TO COBOL-DEMO-GREET-NAME
    CALL "cobol_demo_greet" USING COBOL-DEMO-GREET COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-DEMO-GREET-RESULT NOT = "Hello, COBOL!" OR COBOL-DEMO-GREET-RESULT-LENGTH NOT = 13
        PERFORM FAILED
    END-IF
    *> A result longer than its field fails and reports the length it needed.
    MOVE "long result" TO T-TEST-LABEL
    MOVE ALL "n" TO COBOL-DEMO-GREET-NAME
    CALL "cobol_demo_greet" USING COBOL-DEMO-GREET COBOL-DEMO-STATUS
    MOVE "range" TO T-WANT-KIND
    MOVE "string result is longer than its 256-byte field" TO T-WANT-TEXT
    PERFORM EXPECT-ERROR
    IF COBOL-DEMO-GREET-RESULT-LENGTH NOT = 264 PERFORM FAILED END-IF
    MOVE "defaulted" TO T-TEST-LABEL
    CALL "cobol_verify_defaulted" USING COBOL-VERIFY-DEFAULTED COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-DEFAULTED-RESULT NOT = 42 PERFORM FAILED END-IF
    MOVE 1 TO COBOL-VERIFY-DEFAULTED-GIVEN
    MOVE 12 TO COBOL-VERIFY-DEFAULTED-VALUE
    CALL "cobol_verify_defaulted" USING COBOL-VERIFY-DEFAULTED COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-DEFAULTED-RESULT NOT = 12 PERFORM FAILED END-IF
    MOVE "too many" TO T-TEST-LABEL
    MOVE 2 TO COBOL-VERIFY-DEFAULTED-GIVEN
    CALL "cobol_verify_defaulted" USING COBOL-VERIFY-DEFAULTED COBOL-DEMO-STATUS
    MOVE "argument" TO T-WANT-KIND
    MOVE "argument count must be between 0 and 1" TO T-WANT-TEXT
    PERFORM EXPECT-ERROR
    MOVE "alias" TO T-TEST-LABEL
    MOVE 42 TO COBOL-VERIFY-ALIAS-IDENTITY-VALUE
    CALL "cobol_verify_alias_identity" USING COBOL-VERIFY-ALIAS-IDENTITY COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-VERIFY-ALIAS-IDENTITY-RESULT NOT = 42 PERFORM FAILED END-IF
    MOVE "void" TO T-TEST-LABEL
    CALL "cobol_verify_do_nothing" USING COBOL-VERIFY-DO-NOTHING COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    PERFORM VARYING T-ROUND FROM 1 BY 1 UNTIL T-ROUND > 20
        MOVE "fail" TO T-TEST-LABEL
        CALL "cobol_demo_fail" USING COBOL-DEMO-FAIL COBOL-DEMO-STATUS
        MOVE "native" TO T-WANT-KIND
        MOVE "r_demo::fail: native failure" TO T-WANT-TEXT
        PERFORM EXPECT-ERROR
        IF RETURN-CODE NOT = 5 OR NOT COBOL-DEMO-STATUS-NATIVE PERFORM FAILED END-IF
        MOVE "unknown" TO T-TEST-LABEL
        CALL "cobol_verify_unknown_error" USING COBOL-VERIFY-UNKNOWN-ERROR COBOL-DEMO-STATUS
        MOVE "unknown C++ exception" TO T-WANT-TEXT
        PERFORM EXPECT-ERROR
        MOVE "allocation" TO T-TEST-LABEL
        CALL "cobol_verify_allocation_error" USING COBOL-VERIFY-ALLOCATION-ERROR COBOL-DEMO-STATUS
        MOVE "allocation" TO T-WANT-KIND
        MOVE "allocation" TO T-WANT-TEXT
        PERFORM EXPECT-ERROR
    END-PERFORM
    *> OMITTED skips the status record; RETURN-CODE still has the code.
    MOVE "omitted status" TO T-TEST-LABEL
    CALL "cobol_demo_fail" USING COBOL-DEMO-FAIL OMITTED
    IF RETURN-CODE NOT = 5 PERFORM FAILED END-IF.

NAMES.
    MOVE "type" TO T-TEST-LABEL
    CALL "cobol_names_type" USING COBOL-NAMES-TYPE COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-TYPE-RESULT NOT = 42 PERFORM FAILED END-IF
    MOVE "underscore" TO T-TEST-LABEL
    CALL "cobol_names_private_name" USING COBOL-NAMES-PRIVATE-NAME COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-PRIVATE-NAME-RESULT NOT = 7 PERFORM FAILED END-IF
    MOVE "labels" TO T-TEST-LABEL
    CALL "cobol_names_labels" USING COBOL-NAMES-LABELS COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-LABELS-RESULT NOT = 12 PERFORM FAILED END-IF
    MOVE 2 TO COBOL-NAMES-LABELS-GIVEN
    MOVE 3 TO COBOL-NAMES-LABELS-FIRST
    MOVE 4 TO COBOL-NAMES-LABELS-SECOND
    CALL "cobol_names_labels" USING COBOL-NAMES-LABELS COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-LABELS-RESULT NOT = 34 PERFORM FAILED END-IF
    MOVE "join" TO T-TEST-LABEL
    MOVE "a" TO COBOL-NAMES-JOIN-A
    CALL "cobol_names_join" USING COBOL-NAMES-JOIN COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-JOIN-RESULT NOT = "a-!" PERFORM FAILED END-IF
    MOVE 2 TO COBOL-NAMES-JOIN-GIVEN
    MOVE "+" TO COBOL-NAMES-JOIN-B
    CALL "cobol_names_join" USING COBOL-NAMES-JOIN COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-JOIN-RESULT NOT = "a+!" PERFORM FAILED END-IF
    MOVE "mixed" TO T-TEST-LABEL
    MOVE 1 TO COBOL-NAMES-MIXED-A
    CALL "cobol_names_mixed" USING COBOL-NAMES-MIXED COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-MIXED-RESULT NOT = 4.5 PERFORM FAILED END-IF
    MOVE 3 TO COBOL-NAMES-MIXED-GIVEN
    MOVE 2.5 TO COBOL-NAMES-MIXED-B
    MOVE 3 TO COBOL-NAMES-MIXED-C
    CALL "cobol_names_mixed" USING COBOL-NAMES-MIXED COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-MIXED-RESULT NOT = 6.5 PERFORM FAILED END-IF
    MOVE "shout" TO T-TEST-LABEL
    MOVE "a" TO COBOL-NAMES-SHOUT-LETTER
    CALL "cobol_names_shout" USING COBOL-NAMES-SHOUT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-SHOUT-RESULT NOT = "A" PERFORM FAILED END-IF
    MOVE "length" TO T-TEST-LABEL
    MOVE T-UTF8-TEXT TO COBOL-NAMES-LENGTH-TEXT
    CALL "cobol_names_length" USING COBOL-NAMES-LENGTH COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-LENGTH-RESULT NOT = 10 PERFORM FAILED END-IF
    *> Parameters named after a record's own fields become ARG-n.
    MOVE "keywords" TO T-TEST-LABEL
    MOVE 1 TO COBOL-NAMES-KEYWORDS-ARG-1
    MOVE 2 TO COBOL-NAMES-KEYWORDS-ARG-2
    MOVE 3 TO COBOL-NAMES-KEYWORDS-DISPLAY
    CALL "cobol_names_keywords" USING COBOL-NAMES-KEYWORDS COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-KEYWORDS-RESULT NOT = 6 PERFORM FAILED END-IF
    MOVE "seven" TO T-TEST-LABEL
    MOVE 1 TO COBOL-NAMES-SEVEN-A
    MOVE 2 TO COBOL-NAMES-SEVEN-B
    MOVE 3 TO COBOL-NAMES-SEVEN-C
    MOVE 4 TO COBOL-NAMES-SEVEN-D
    MOVE 5 TO COBOL-NAMES-SEVEN-E
    MOVE 6 TO COBOL-NAMES-SEVEN-F
    MOVE 7 TO COBOL-NAMES-SEVEN-G
    CALL "cobol_names_seven" USING COBOL-NAMES-SEVEN COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-SEVEN-RESULT NOT = 28 PERFORM FAILED END-IF
    MOVE "depth" TO T-TEST-LABEL
    CALL "cobol_names_depth" USING COBOL-NAMES-DEPTH COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-DEPTH-RESULT NOT = 1 PERFORM FAILED END-IF
    MOVE "point" TO T-TEST-LABEL
    MOVE 2 TO COBOL-NAMES-POINT-NEW-GIVEN
    MOVE 1 TO COBOL-NAMES-POINT-NEW-X
    MOVE 2 TO COBOL-NAMES-POINT-NEW-Y
    CALL "cobol_names_point_new" USING COBOL-NAMES-POINT-NEW COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    MOVE COBOL-NAMES-POINT-NEW-RESULT TO T-POINT
    MOVE "sum" TO T-TEST-LABEL
    MOVE T-POINT TO COBOL-NAMES-POINT-SUM-SELF
    CALL "cobol_names_point_sum" USING COBOL-NAMES-POINT-SUM COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-POINT-SUM-RESULT NOT = 3 PERFORM FAILED END-IF
    MOVE 1 TO COBOL-NAMES-POINT-SUM-GIVEN
    MOVE 2 TO COBOL-NAMES-POINT-SUM-SCALE
    CALL "cobol_names_point_sum" USING COBOL-NAMES-POINT-SUM COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-POINT-SUM-RESULT NOT = 6 PERFORM FAILED END-IF
    MOVE "origin" TO T-TEST-LABEL
    CALL "cobol_names_point_origin" USING COBOL-NAMES-POINT-ORIGIN COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-POINT-ORIGIN-RESULT NOT = 0 PERFORM FAILED END-IF
    MOVE "x" TO T-TEST-LABEL
    MOVE T-POINT TO COBOL-NAMES-POINT-X-SELF
    CALL "cobol_names_point_get_x" USING COBOL-NAMES-POINT-X COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-POINT-X-VALUE NOT = 1 PERFORM FAILED END-IF
    MOVE 5 TO COBOL-NAMES-POINT-X-VALUE
    CALL "cobol_names_point_set_x" USING COBOL-NAMES-POINT-X COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    MOVE 0 TO COBOL-NAMES-POINT-SUM-GIVEN
    CALL "cobol_names_point_sum" USING COBOL-NAMES-POINT-SUM COBOL-DEMO-STATUS
    IF COBOL-NAMES-POINT-SUM-RESULT NOT = 7 PERFORM FAILED END-IF
    MOVE "tag" TO T-TEST-LABEL
    MOVE T-POINT TO COBOL-NAMES-POINT-TAG-SELF
    CALL "cobol_names_point_get_tag" USING COBOL-NAMES-POINT-TAG COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-POINT-TAG-VALUE NOT = "p" PERFORM FAILED END-IF
    MOVE "z" TO COBOL-NAMES-POINT-TAG-VALUE
    CALL "cobol_names_point_set_tag" USING COBOL-NAMES-POINT-TAG COBOL-DEMO-STATUS
    MOVE SPACE TO COBOL-NAMES-POINT-TAG-VALUE
    CALL "cobol_names_point_get_tag" USING COBOL-NAMES-POINT-TAG COBOL-DEMO-STATUS
    IF COBOL-NAMES-POINT-TAG-VALUE NOT = "z" PERFORM FAILED END-IF
    MOVE "weight" TO T-TEST-LABEL
    MOVE T-POINT TO COBOL-NAMES-POINT-WEIGHT-SELF
    CALL "cobol_names_point_get_weight" USING COBOL-NAMES-POINT-WEIGHT COBOL-DEMO-STATUS
    PERFORM EXPECT-OK
    IF COBOL-NAMES-POINT-WEIGHT-VALUE NOT = 1.5 PERFORM FAILED END-IF
