;;; Full Guile API (--guile-api full) on the library-shaped example shared with the Python, C#,
;;; Ruby, Julia, Common Lisp and Fortran backends (examples/python_features.hpp). The generated
;;; module (features) and its extension are found through GUILE_LOAD_PATH.
(use-modules (oop goops)
             (features)
             ((features data) #:prefix data:)
             (ice-9 exceptions)
             (ice-9 documentation)
             (ice-9 threads)
             ((srfi srfi-1) #:select (every third))) ; find and first are features procedures

(define checks 0)
(define (check ok what)
  (set! checks (+ checks 1))
  (unless ok (error "check failed:" what)))

;; Runs THUNK, expecting an exception whose key is KEY (#t: any) and whose printed arguments
;; contain PATTERN; returns (key . args).
(define (fails key pattern thunk)
  (set! checks (+ checks 1))
  (let ((caught (catch #t (lambda () (thunk) #f) (lambda (k . args) (cons k args)))))
    (unless caught (error "expected an error containing" pattern))
    (unless (or (eq? key #t) (eq? (car caught) key))
      (error "expected key" key 'got caught))
    (unless (string-contains (format #f "~a" (cdr caught)) pattern)
      (error "expected an error containing" pattern 'got caught))
    caught))
(define (collect) (gc) (gc) (gc))
(define (near a b) (< (abs (- a b)) 1e-9))

;;; Directors: Scheme subclasses implement C++ virtual methods.
(define-class <triangle> (<shape>)
  (base #:init-keyword #:base)
  (height #:init-keyword #:height))
(define-method (area (self <triangle>)) (/ (* (slot-ref self 'base) (slot-ref self 'height)) 2.0))
(define-method (name (self <triangle>)) "triangle")
(define-class <incomplete> (<shape>))
(define-class <failing> (<shape>))
(define-method (area (self <failing>)) (error "from Scheme"))
;; next-method runs the native implementation rather than dispatching back to the override.
(define-class <loud> (<circle>))
(define-method (name (self <loud>)) (string-upcase (next-method)))
(define-class <noisy> (<circle>))
(define-method (name (self <noisy>)) (string-append (string-downcase (next-method)) "!"))
(define-class <louder> (<noisy>))
(define-class <unit-shape> (<shape>) (tag #:init-value #f #:init-keyword #:tag))
(define-method (area (self <unit-shape>)) 1.0)
(define-class <summer> (<visitor>) (seen #:init-value #f))
(define-method (visit (self <summer>) value) (* value 10))
(define-method (finished (self <summer>) values) (slot-set! self 'seen values))
(define-class <no-super> (<shape>))
(define-method (initialize (self <no-super>) initargs) self) ; forgets next-method

;;; --- Classes, inheritance and virtual dispatch ------------------------------------------------
(define c1 (make <circle> 2.0))
(check (= (area c1) 12.0) "circle area")
(check (string=? (name c1) "circle") "circle name")
(check (= (twice-area c1) 24.0) "non-virtual base method")
(check (= (radius c1) 2.0) "circle radius")
(check (string-contains (format #f "~a" c1) "<circle>") "printed form names the class")
(check (string-contains (format #f "~s" c1) "<circle>") "written form names the class")
(check (is-a? c1 <shape>) "is-a? base class")
(check (is-a? c1 <native-object>) "is-a? <native-object>")
(check (memq <shape> (class-direct-supers <circle>)) "class hierarchy")
(fails 'features-invalid-argument "negative radius" (lambda () (make <circle> -1.0)))
(define negative
  (with-exception-handler (lambda (e) e) (lambda () (make <circle> -1.0)) #:unwind? #t))
(check (features-error? negative) "features-error? on the exception object")
(check (eq? (features-error-kind negative) 'features-invalid-argument) "error kind")
(check (string=? (features-error-message negative) "negative radius") "error message")
(check (string=? (features-error-cpp-class negative) "std::invalid_argument") "error cpp class")
(check (error? negative) "C++ exceptions are &error")
(check (string=? (exception-message negative) "negative radius") "exception-message")
(check (features-error? 'features-out-of-range) "features-error? on a key")
(check (not (features-error? 'wrong-type-arg)) "Guile keys are not module errors")
(define s (make <square>))
(check (and (= (side s) 1.0) (= (area s) 1.0)) "default constructor")
(set-side! s 3.0)
(check (= (area s) 9.0) "field setter")
(set! (side s) 4.0)
(check (= (area s) 16.0) "generalized set! on a field")
(set-side! s 3.0)
(check (= (area (make <square> 2.0)) 4.0) "constructor overload")
(check (= (area-of s) 9.0) "function on a class argument")
(check (string=? (describe c1) "circle:0") "function on a class argument (string result)")
(check (= (radius (make <circle> 3)) 3.0) "exact integer converts to a real")
(fails 'wrong-type-arg "make <circle>" (lambda () (make <circle> "2")))
(fails 'wrong-number-of-args "wrong number of arguments" (lambda () (make <circle>)))
(fails 'features-type-error "cannot be constructed" (lambda () (make <target>)))
(check (= (area (make-circle 1.0)) 3.0) "make-<class> convenience procedure")

;;; --- Enums ------------------------------------------------------------------------------------
(check (eq? (kind c1) 'circle) "enum results are symbols")
(check (eq? (kind s) 'square) "enum result from an override")
(check (filled? 'solid) "enum argument")
(check (not (filled? 'none)) "enum argument (renamed enumerator)")
(check (filled? 1) "enum integer argument")
(check (equal? (kind-values) '(circle square custom)) "enum values")
(check (= (kind->integer 'custom) 7) "enum->integer")
(check (eq? (integer->kind 7) 'custom) "integer->enum")
(check (not (integer->kind 99)) "integer->enum unknown")
(check (= (kind->integer 1) 1) "enum->integer of an integer")
(fails 'features-invalid-argument "hexagon" (lambda () (kind->integer 'hexagon)))
(fails 'features-invalid-argument "unknown enumerator hexagon" (lambda () (make-shape 'hexagon 1.0)))
(fails 'wrong-type-arg "make-shape" (lambda () (make-shape "circle" 1.0)))
(check (equal? (legacy-values) '(legacy-a legacy-b)) "unscoped enum values")
(check (= (legacy->integer 'legacy-b) 2) "unscoped enum value")
(check (equal? (fill-values) '(none solid)) "enumerator names are kebab-case")
(check (= shape-sides-unknown -1) "class constant")
(check (near golden 1.618) "namespace constant")

;;; --- Most-derived results, ownership transfer and shared ownership -----------------------------
(define made (make-shape 'circle 1.0))
(check (eq? (class-of made) <circle>) "most-derived result")
(check (= (radius made) 1.0) "most-derived result methods")
(check (eq? (class-of (make-shape 'square 2.0)) <square>) "most-derived square")
(check (and (owned? made) (alive? made) (not (closed? made))) "owned result")
(define canvas (make <canvas>))
(add canvas (make-shape 'square 2.0))
(share canvas (shared-square 3.0))
(define transferred (make <circle> 1.0))
(add canvas transferred)
(fails 'features-runtime-error "closed" (lambda () (area transferred)))
(check (and (closed? transferred) (not (alive? transferred))) "transferred object is closed")
(check (= (size canvas) 3) "ownership transfer: size")
(check (= (total canvas) (+ 4.0 9.0 3.0)) "ownership transfer: total")
(define first-shape (at canvas 0))
(check (eq? (class-of first-shape) <square>) "borrowed element class")
(check (= (area first-shape) 4.0) "borrowed element")
(check (not (owned? first-shape)) "borrowed element is not owned")
(fails 'features-invalid-argument "cannot transfer ownership" (lambda () (add canvas first-shape)))
(define shared (shared-square 2.0))
(share canvas shared)
(check (= (area shared) 4.0) "shared object stays usable")
(check (= (total canvas) 20.0) "shared ownership")
(check (= (total-area (list (make <circle> 1.0) shared)) 7.0) "list of objects")
(check (= (total-area (vector (make <circle> 1.0) shared)) 7.0) "vector of objects")
(fails 'wrong-type-arg "total-area" (lambda () (total-area (make <circle> 1.0))))
(fails 'features-out-of-range "" (lambda () (at canvas 10)))

;;; --- Overload resolution ----------------------------------------------------------------------
(check (string=? (pick 1) "int") "exact integer overload")
(check (string=? (pick 1.5) "double") "real overload")
(check (string=? (pick 2.0) "double") "inexact integer-valued real overload")
(check (string=? (pick "x") "string") "string overload")
(check (string=? (pick '(1.0 2.0)) "vector") "list overload")
(check (string=? (pick #(1.0 2.0)) "vector") "vector overload")
(check (string=? (pick s) "shape") "class overload")
(check (string=? (pick '(1 2)) "vector") "lenient pass converts exact elements")
(check (string=? (pick 'sym) "string") "lenient pass takes a symbol for a string")
(fails 'wrong-type-arg "no overload accepts" (lambda () (pick #f)))
(fails 'wrong-type-arg "supported signatures" (lambda () (pick #f)))
(fails 'wrong-number-of-args "wrong number of arguments" (lambda () (pick 'sym 2 3)))
(check (= (add 1) 111) "all defaults")
(check (= (add 1 2) 103) "one default")
(check (= (add 1 2 3) 6) "no defaults")
(check (= (add 1 #:default 3) 14) "#:default skips a parameter")
(check (= (add 1 #:default #:default) 111) "#:default for every optional")
(fails 'wrong-number-of-args "add" (lambda () (add)))
(fails 'wrong-number-of-args "add" (lambda () (add 1 2 3 4)))

;;; --- Integer range checks and bignums ---------------------------------------------------------
(fails 'out-of-range "outside the range" (lambda () (add (expt 2 40))))
(fails 'out-of-range "outside the range" (lambda () (add (expt 2 80))))
(fails 'out-of-range "outside the range" (lambda () (add (expt 2 31))))
(check (= (add (- (expt 2 31)) 0 0) (- (expt 2 31))) "int minimum")
(check (= (add 2147483647 0 0) 2147483647) "int maximum")
(fails 'wrong-type-arg "exact integer" (lambda () (add 1.5)))
(fails 'wrong-type-arg "exact integer" (lambda () (add 1 2.0)))
