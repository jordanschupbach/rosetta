(check (string-contains (doc add) "Adds three integers, Socha & Dorigo style.") "summary")
(check (string-contains (doc add) "A: first term. Exact integer.") "argument")
(check (string-contains (doc add) "B: second term. Exact integer; default 10.") "argument default")
(check (string-contains (doc add) "Returns: the sum. Exact integer.") "returns")
(check (string-contains (doc add) "Raises: features-out-of-range") "raises")
(check (string-contains (doc add) "C++: int features::add(int a, int b = 10, int c = 100)") "C++ signature")
(check (string-contains (doc area) "Area of the shape") "method documentation")
(check (string-contains (doc area) "define-method") "generic documentation")
(check (string-contains (doc x) "Horizontal component.") "field documentation")
(check (string-contains (doc pick) "(pick ARG0)") "overload signatures")
(check (string-contains (doc count-words) "Alist of (string . exact integer)") "alist type")
(check (string-contains (doc find) "Exact integer or #f") "optional type")
(check (string-contains (doc min-max) "Pair (real . real)") "pair type")
(check (string-contains (doc apply) "Procedure (real -> real)") "procedure type")
(check (string-contains (doc filled?) "Symbol (one of none, solid)") "enum type")
(check (string-contains (doc make-circle) "negative") "constructor documentation")
(check (string-contains (object-documentation <shape>) "Subclass it with define-class") "class documentation")
(check (string-contains (doc data:unit) "Mapped by the policy's modules") "submodule documentation")

;;; --- Policy modules ---------------------------------------------------------------------------
(define pt (data:unit))
(check (and (= (x pt) 1.0) (= (y pt) 0.0)) "submodule result")
(check (= (data:scaled 3) 6) "submodule overload (integer)")
(check (= (data:scaled 2.5) 6.25) "submodule overload (real)")
(check (string=? (data:repeat "ab") "abab") "submodule names are separate")
(check (string=? (repeat #\x 3) "xxx") "top-level name with the same spelling")

(when (member "--compiled" (command-line))
  ;; Run from the precompiled .go files (rosetta_compile_guile), not interpreted from source.
  (let ((sources ((@ (system vm program) program-sources) (@@ (features) %no-setter))))
    (check (and (pair? sources) (equal? (cadar sources) "features.scm")) "the module was loaded from features.go"))
  (let ((sources ((@ (system vm program) program-sources) (@@ (features data) scaled))))
    (check (and (pair? sources) (equal? (cadar sources) "features/data.scm")) "the submodule was loaded from features/data.go")))

(collect)
(format #t "Guile full API passed (~a checks)\n" checks)
