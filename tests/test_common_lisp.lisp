;;;; Runtime tests for the generated Common Lisp bindings (SBCL).
;;;; Environment: ROSETTA_LISP_FAMILY, ROSETTA_LISP_BUILD and ROSETTA_LISP_REPL.
(defpackage "ROSETTA-LISP-TEST" (:use "COMMON-LISP"))
(in-package "ROSETTA-LISP-TEST")

(defvar *family* (sb-ext:posix-getenv "ROSETTA_LISP_FAMILY"))
(defvar *build* (concatenate 'string (sb-ext:posix-getenv "ROSETTA_LISP_BUILD") "/"))
(if (string= *family* "repl")
    (load (sb-ext:posix-getenv "ROSETTA_LISP_REPL"))
    (progn (load (concatenate 'string *build* "lisp_demo.lisp"))
           (load (concatenate 'string *build* "lisp_verify.lisp"))))
;; Loaded before the forms below are read, since they name its package.
(load (concatenate 'string *build* "lisp_names.lisp"))

(defvar *passes* 0)
(defvar *failures* 0)
(defun report (ok description)
  (if ok (incf *passes*) (progn (incf *failures*) (format t "FAIL ~A~%" description)))
  ok)
(defmacro check (form) `(report ,form ',form))
(defun error-kind (condition)
  (typecase condition
    (lisp_demo:rosetta-error (lisp_demo:rosetta-error-kind condition))
    (lisp_verify:rosetta-error (lisp_verify:rosetta-error-kind condition))))
(defun fails* (thunk fragment kind description)
  (handler-case (progn (funcall thunk) (report nil (format nil "no error (~A) from ~A" fragment description)))
    (error (condition)
      (let ((text (princ-to-string condition)))
        (report (search fragment text) (format nil "~A: expected ~S in ~S" description fragment text))
        (when kind
          (report (eq kind (error-kind condition))
                  (format nil "~A: expected kind ~S, got ~S" description kind (error-kind condition))))))))
(defmacro fails (form fragment &optional kind) `(fails* (lambda () ,form) ,fragment ,kind ',form))

(defun v (name &rest arguments)
  (apply (or (find-symbol (string-upcase (concatenate 'string "r_verify__" name)) "LISP_VERIFY")
             (error "no verify export ~A" name))
         arguments))
(defun live () (lisp_demo:r_demo__counter__live))
(defun collect-until (predicate)
  ;; Finalizers run on SBCL's finalizer thread after a collection.
  (loop repeat 100
        do (sb-ext:gc :full t) (sleep 0.02)
        when (funcall predicate) return t))
(defun temporary-owners ()
  (let ((counter (lisp_demo:r_demo__counter 1)))
    (list counter counter (lisp_verify:r_verify__series) (lisp_verify:r_verify__worklist 2)
          (lisp_verify:r_verify__asynctask 1 60000 nil)))
  nil)
;; Made on a finished thread so no stale stack slot can keep it alive
;; (SBCL scans stacks conservatively).
(defun abandoned-counter ()
  (sb-thread:join-thread
   (sb-thread:make-thread (lambda () (trivial-garbage:make-weak-pointer (lisp_demo:r_demo__counter 1))))))
(defparameter *nan* (sb-kernel:make-double-float -524288 0))
(defparameter *pending* nil)

(cond
  ((string= *family* "scalars")
   (check (= 42 (lisp_names:list)))
   (check (= 42 (lisp_names:car 42)))
   (check (not (eq 'lisp_names:list 'cl:list)))
   (check (equal '(20 22) (cl:list 20 22)))
   (dolist (name '("char" "schar" "uchar" "short" "ushort" "int" "uint" "long" "ulong" "ll" "ull"))
     (let ((name (concatenate 'string "echo_" name)))
       (check (eql 42 (v name 42)))
       (check (eql 42 (v name 42d0)))
       (dolist (bad (list t nil "42" '(42) #(42) #c(1 2) 3/2 1.5d0 *nan* sb-ext:double-float-positive-infinity))
         (fails* (lambda () (v name bad)) "expected" :conversion (format nil "~A ~S" name bad)))
       (fails (v name (expt 2d0 54)) "exact integer")
       (fails (v name (expt 2f0 25)) "exact integer")))
   (loop for (name bits) in '(("schar" 8) ("short" 16) ("int" 32) ("ll" 64))
         for name* = (concatenate 'string "echo_" name)
         for low = (- (expt 2 (1- bits)))
         for high = (1- (expt 2 (1- bits)))
         do (check (eql low (v name* low)))
            (check (eql high (v name* high)))
            (fails (v name* (1- (expt 2 64))) "range")
            (fails (v name* (1- low)) "range")
            (fails (v name* (1+ high)) "range"))
   (loop for (name bits) in '(("uchar" 8) ("ushort" 16) ("uint" 32) ("ull" 64))
         for name* = (concatenate 'string "echo_" name)
         do (check (eql (1- (expt 2 bits)) (v name* (1- (expt 2 bits)))))
            (fails (v name* -1) "range")
            (fails (v name* (expt 2 bits)) "range"))
   (let ((exact (1+ (expt 2 53))))
     (check (eql exact (lisp_demo:r_demo__too_large)))
     (check (eql exact (v "echo_ull" exact))))
   (check (eql 1.25f0 (v "echo_float" 1.25d0)))
   (check (eql 1.25f0 (v "echo_float" 1.25f0)))
   (check (eql most-positive-double-float (v "echo_double" most-positive-double-float)))
   (fails (v "echo_float" 1d39) "finite")
   (fails (v "nonfinite_result") "non-finite")
   (check (eq t (v "echo_bool" t)))
   (check (eq nil (v "echo_bool" nil)))
   (dolist (bad (list 0 1 "true" '(t)))
     (fails* (lambda () (v "echo_bool" bad)) "expected" :conversion (format nil "echo_bool ~S" bad)))
   (dolist (text (list "" "world" "世界😀" (format nil "a~Cb" (code-char 0))
                       (with-output-to-string (s) (dotimes (i 10000) (write-string "long" s)))))
     (check (string= text (v "echo_string" text))))
   (check (string= "世界" (v "echo_string" (babel:string-to-octets "世界" :encoding :utf-8))))
   (fails (v "echo_string" (coerce #(255 254) '(vector (unsigned-byte 8)))) "not valid UTF-8" :conversion)
   (check (string= (format nil "a~Cb" (code-char 0)) (v "embedded_nul")))
   (check (eql 42 (v "defaulted")))
   (check (eql 12 (v "defaulted" 12)))
   (check (eql 42 (v "alias_identity" 42)))
   (check (null (v "do_nothing")))
   (fails (v "echo_int") "number")
   (fails (v "echo_int" 1 2) "number")
   (dotimes (i 20)
     (fails (lisp_demo:r_demo__fail) "native failure" :native)
     (fails (v "unknown_error") "unknown C++ exception" :native)
     (fails (v "allocation_error") "allocation" :allocation)
     (check (eql 42 (lisp_demo:r_demo__add 20 22))))
   ;; Strings are copied into foreign memory, so collections on another
   ;; thread cannot move them mid-call.
   (let ((collector (sb-thread:make-thread (lambda () (dotimes (i 20) (sb-ext:gc :full t) (sleep 0.001))))))
     (dotimes (i 100)
       (let ((text (format nil "~{~A~}~D" (make-list 1000 :initial-element (format nil "gc~C😀" (code-char 0))) i)))
         (check (string= text (v "echo_string" text)))))
     (sb-thread:join-thread collector)))

  ((string= *family* "objects")
   (check (eql 0 (live)))
   (fails (lisp_demo:r_demo__counter -1) "negative initial")
   (check (eql 0 (live)))
   (fails (lisp_demo:r_demo__counter) "number")
   (let* ((c (lisp_demo:r_demo__counter 20)) (alias c))
     (check (eql 1 (live)))
     (check (eql 42 (lisp_demo:r_demo__counter__add c 22)))
     (check (eql 42 (lisp_demo:r_demo__counter__value c)))
     (check (eql 42 (lisp_demo:r_demo__counter__count c)))
     (check (eql 20 (lisp_demo:r_demo__counter__initial c)))
     (check (eql 42 (lisp_demo:r_demo__counter__answer)))
     (setf (lisp_demo:r_demo__counter__count c) 7)
     (check (eql 7 (lisp_demo:r_demo__counter__value alias)))
     (let ((label (format nil "世界😀~C" (code-char 0))))
       (check (string= label (setf (lisp_demo:r_demo__counter__label c) label)))
       (check (string= label (lisp_demo:r_demo__counter__label alias))))
     (fails (setf (lisp_demo:r_demo__counter__initial c) 1) "readonly")
     (fails (setf (lisp_demo:r_demo__counter__count c) t) "numeric")
     (fails (setf (lisp_demo:r_demo__counter__label c) 1) "string")
     (fails (lisp_demo:r_demo__counter__add c 1 2) "number")
     (check (typep c 'lisp_demo:native-owner))
     (let ((foreign (lisp_verify:r_verify__series))
           (other (lisp_verify:r_verify__worklist 2))
           (internal (lambda (name) (find-symbol name "LISP_VERIFY.IMPL"))))
       (fails (lisp_demo:r_demo__counter__add c foreign) "expected")
       (fails (lisp_demo:r_demo__counter__add foreign 1) "expected a R_DEMO__COUNTER owner")
       ;; A forged internal ID is checked against the native record type.
       (fails (funcall (funcall internal "INVOKE") "r_verify__Series.get"
                       (slot-value other (funcall internal "ID")) '())
              "foreign native owner")
       (close other)
       (close foreign))
     (fails (make-load-form c) "native owners cannot" :ownership)
     (check (search "R_DEMO__COUNTER" (princ-to-string c)))
     (close c)
     (close c)
     (check (eql 0 (live)))
     (check (search "closed" (princ-to-string alias)))
     (fails (lisp_demo:r_demo__counter__value alias) "closed")
     (fails (lisp_demo:r_demo__counter__count alias) "closed")
     (fails (setf (lisp_demo:r_demo__counter__count alias) 1) "closed"))
   (check (eql 42 (lisp_demo:with-owner (c (lisp_demo:r_demo__counter 20)) (lisp_demo:r_demo__counter__add c 22))))
   (check (eql 0 (live)))
   (temporary-owners)
   (check (collect-until (lambda () (and (eql 0 (live)) (eql 0 (lisp_verify:r_verify__series__live))
                                         (eql 0 (lisp_verify:r_verify__asynctask__workers))))))
   (let ((weak (abandoned-counter)))
     (check (collect-until (lambda () (and (null (trivial-garbage:weak-pointer-value weak)) (eql 0 (live)))))))
   ;; Concurrent calls and close are serialized inside the generated library.
   (let* ((c (lisp_demo:r_demo__counter 1))
          (jobs (loop repeat 20
                      collect (sb-thread:make-thread
                               (lambda ()
                                 (handler-case (lisp_demo:r_demo__counter__add c 1)
                                   (error (e) (search "closed" (princ-to-string e)))))))))
     (close c)
     (dolist (job jobs) (check (sb-thread:join-thread job)))
     (check (eql 0 (live)))))

  ((string= *family* "features")
   (check (eql 42 (v "maximum" 20 42)))
   (check (eql 42 (v "template_box" 42)))
   (check (eql 42 (v "variadic_sum" 10 20 12)))
   (check (eql 42 (v "constant_answer")))
   (check (eql 42 (v "constrained_sum" 20 22)))
   (check (eql 42 (v "hierarchy_value" 42)))
   (check (eq t (v "hierarchy_crosscast")))
   (check (eql 42 (v "rosetta_r_c_identity" 42)))
   (fails (v "constrained_sum" (1- (expt 2 31)) 1) "overflow" :range)
   (fails (lisp_verify:r_verify__series 0 -1) "series count" :index)
   (lisp_verify:with-owner (s (lisp_verify:r_verify__series))
     (check (eql 2 (lisp_verify:r_verify__series__size s)))
     (check (eql 20 (lisp_verify:r_verify__series__get s)))
     (check (eql 82 (lisp_verify:r_verify__series__scaled_sum s 2)))
     (check (string= "[20, 21]" (lisp_verify:r_verify__series__text s)))
     (lisp_verify:r_verify__series__set s 1 22)
     (check (eql 42 (lisp_verify:r_verify__series__scaled_sum s 1)))
     (fails (lisp_verify:r_verify__series__get s 2) "out of range" :index)
     (fails (lisp_verify:r_verify__series__set s -1 1) "out of range"))
   (loop for order from 1 to 4
         for expected in '(("m" "z" "a") ("a" "z" "m") ("z" "m" "a") ("a" "m" "z"))
         do (lisp_verify:with-owner (q (lisp_verify:r_verify__worklist order))
              (dolist (x '("a" "z" "m")) (lisp_verify:r_verify__worklist__push q x))
              (check (eql 3 (lisp_verify:r_verify__worklist__size q)))
              (check (equal expected (loop repeat 3 collect (lisp_verify:r_verify__worklist__pop q))))
              (fails (lisp_verify:r_verify__worklist__pop q) "empty" :index)))
   (fails (lisp_verify:r_verify__worklist 0) "unknown worklist order" :argument)
   (lisp_verify:with-owner (task (lisp_verify:r_verify__asynctask 21 0 nil))
     (check (lisp_verify:r_verify__asynctask__wait task 2000))
     (check (eql 42 (lisp_verify:r_verify__asynctask__result task)))
     (check (eql 42 (lisp_verify:r_verify__asynctask__result task))))
   (lisp_verify:with-owner (task (lisp_verify:r_verify__asynctask 1 0 t))
     (check (lisp_verify:r_verify__asynctask__wait task 2000))
     (fails (lisp_verify:r_verify__asynctask__result task) "async worker failure"))
   (lisp_verify:with-owner (task (lisp_verify:r_verify__asynctask 1 60000 nil))
     (check (not (lisp_verify:r_verify__asynctask__ready task)))
     (check (not (lisp_verify:r_verify__asynctask__wait task 0)))
     (check (lisp_verify:r_verify__asynctask__cancel task))
     (check (lisp_verify:r_verify__asynctask__wait task 2000))
     (fails (lisp_verify:r_verify__asynctask__result task) "cancelled"))
   (fails (lisp_verify:r_verify__asynctask 1 -1 nil) "delay" :index)
   (temporary-owners)
   (check (collect-until (lambda () (eql 0 (lisp_verify:r_verify__asynctask__workers)))))
   ;; Leave a 60s worker referenced until exit; the exit hook cancels and joins it.
   (setf *pending* (lisp_verify:r_verify__asynctask 1 60000 nil)))

  ((string= *family* "repl")
   (check (eql 42 (lisp_demo:r_demo__add 20 22)))
   (lisp_demo:with-owner (c (lisp_demo:r_demo__counter 20))
     (check (eql 42 (lisp_demo:r_demo__counter__add c 22))))
   (lisp_verify:with-owner (s (lisp_verify:r_verify__series))
     (check (eql 82 (lisp_verify:r_verify__series__scaled_sum s 2)))))

  (t (error "unknown family ~A" *family*)))

(format t "Common Lisp ~A: ~D passed, ~D failed~%" *family* *passes* *failures*)
(sb-ext:exit :code (if (zerop *failures*) 0 1))
