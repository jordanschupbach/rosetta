;;; Runtime tests for the generated Guile extensions.
;;; Usage: guile --no-auto-compile -s test_guile.scm FAMILY REPL_SCRIPT,
;;; with the build directory on GUILE_LOAD_PATH.
(use-modules (ice-9 exceptions) (ice-9 threads) (srfi srfi-34))
(define family (cadr (command-line)))
(if (string=? family "repl")
    (load (caddr (command-line)))
    (use-modules (guile_demo) (guile_verify)))
(use-modules ((guile_names) #:prefix names:))

(define passes 0)
(define failures 0)
(define (report ok description)
  (if ok
      (set! passes (+ passes 1))
      (begin (set! failures (+ failures 1)) (format #t "FAIL ~s\n" description))))
(define-syntax check
  (syntax-rules ()
    ((_ expression)
     (report (catch #t (lambda () expression)
               (lambda (key . args) (format #t "error ~a ~s\n" key args) #f))
             'expression))))
(define (exception-text key args)
  (call-with-output-string (lambda (port) (print-exception port #f key args))))
;; (fails EXPRESSION FRAGMENT [KIND]): KIND is a rosetta error kind, or the
;; key of a Guile error such as wrong-number-of-args.
(define-syntax fails
  (syntax-rules ()
    ((_ expression fragment) (fails expression fragment #f))
    ((_ expression fragment kind)
     (let ((outcome (catch #t (lambda () expression #f) (lambda (key . args) (cons key args)))))
       (if (not outcome)
           (report #f (list 'no-error 'expression))
           (let* ((key (car outcome))
                  (args (cdr outcome))
                  (text (exception-text key args))
                  (actual (if (eq? key 'rosetta-error) (car (list-ref args 3)) key)))
             (report (string-contains text fragment) (list 'expression 'expected fragment 'got text))
             (when kind (report (eq? actual kind) (list 'expression 'expected kind 'got actual)))))))))
(define (v name . args)
  (apply (module-ref (resolve-interface '(guile_verify)) (string->symbol (string-append "r_verify__" name))) args))
(define (exported? module name) (module-defined? (resolve-interface module) name))
(define (live) (r_demo__Counter-live))
;; Finalizers run on Guile's finalizer thread after a collection.
(define (eventually thunk)
  (let loop ((tries 0))
    (cond ((thunk) #t)
          ((= tries 200) #f)
          (else (gc) (usleep 10000) (loop (+ tries 1))))))

(cond
 ((string=? family "scalars")
  (check (= (names:list) 42))
  (check (= (names:list 7) 7))
  (check (= (names:display 42) 42))
  (check (equal? (list 1 2) '(1 2)))
  (for-each
   (lambda (type)
     (let ((name (string-append "echo_" type)))
       (check (= (v name 42) 42))
       (for-each (lambda (bad) (fails (v name bad) "expected an exact integer" 'conversion))
                 (list 42.0 1/2 #t "42" '() 'x))
       (fails (v name (expt 2 64)) "range" 'range)))
   '("char" "schar" "uchar" "short" "ushort" "int" "uint" "long" "ulong" "ll" "ull"))
  (for-each
   (lambda (type bits)
     (let ((name (string-append "echo_" type))
           (low (- (expt 2 (- bits 1))))
           (high (- (expt 2 (- bits 1)) 1)))
       (check (= (v name low) low))
       (check (= (v name high) high))
       (fails (v name (- low 1)) "range" 'range)
       (fails (v name (+ high 1)) "range" 'range)))
   '("schar" "short" "int" "ll") '(8 16 32 64))
  (for-each
   (lambda (type bits)
     (let ((name (string-append "echo_" type)) (high (- (expt 2 bits) 1)))
       (check (= (v name high) high))
       (fails (v name -1) "range" 'range)
       (fails (v name (+ high 1)) "range" 'range)))
   '("uchar" "ushort" "uint" "ull") '(8 16 32 64))
  (let ((exact (+ (expt 2 53) 1)))
    (check (= (r_demo__too_large) exact))
    (check (exact? (r_demo__too_large)))
    (check (= (v "echo_ull" exact) exact)))
  (check (= (v "echo_float" 1.25) 1.25))
  (check (let ((x (v "echo_float" 2))) (and (inexact? x) (= x 2.0))))
  (check (= (v "echo_double" 1/2) 0.5))
  (check (= (v "echo_double" 1.7976931348623157e308) 1.7976931348623157e308))
  (fails (v "echo_float" 1e39) "outside C++ type range" 'range)
  (fails (v "echo_double" +inf.0) "finite" 'range)
  (fails (v "echo_double" +nan.0) "finite" 'range)
  (fails (v "echo_double" "abc") "expected a real number" 'conversion)
  (fails (v "echo_double" 1+2i) "expected a real number" 'conversion)
  (fails (v "nonfinite_result") "non-finite" 'range)
  (check (eq? (v "echo_bool" #t) #t))
  (check (eq? (v "echo_bool" #f) #f))
  (for-each (lambda (bad) (fails (v "echo_bool" bad) "expected a boolean" 'conversion)) (list 0 1 '() "true"))
  (let ((long (string-concatenate (make-list 10000 "long"))))
    (for-each (lambda (text) (check (string=? (v "echo_string" text) text)))
              (list "" "world" "世界😀" "a\x00b" long (string (integer->char 255) (integer->char 254)))))
  (check (= (string-length (v "echo_string" "世界😀")) 3))
  (check (and (string=? (v "embedded_nul") "a\x00b") (= (string-length (v "embedded_nul")) 3)))
  (fails (v "echo_string" 42) "expected a string" 'conversion)
  (check (= (v "defaulted") 42))
  (check (= (v "defaulted" 12) 12))
  (check (= (v "alias_identity" 42) 42))
  (check (unspecified? (v "do_nothing")))
  (fails (v "echo_int") "Wrong number of arguments" 'wrong-number-of-args)
  (fails (v "echo_int" 1 2) "Wrong number of arguments" 'wrong-number-of-args)
  (fails (v "defaulted" 1 2) "Wrong number of arguments" 'wrong-number-of-args)
  (do ((i 0 (+ i 1))) ((= i 20))
    (fails (r_demo__fail) "native failure" 'native)
    (fails (v "unknown_error") "unknown C++ exception" 'native)
    (fails (v "allocation_error") "allocation" 'allocation)
    (check (= (r_demo__add 20 22) 42)))
  (check (equal? (catch 'rosetta-error r_demo__fail (lambda (key subr message irritants data) (list subr message data)))
                 '("r_demo__fail" "native failure" (native))))
  (check (equal? (guard (e ((eq? (exception-kind e) 'rosetta-error) (list (exception-origin e) (exception-message e))))
                   (r_demo__fail))
                 '("r_demo__fail" "native failure")))
  (check (string=? (catch 'rosetta-error r_demo__fail (lambda (key . args) (exception-text key args)))
                   "native failure (rosetta native)\n")))

 ((string=? family "objects")
  (check (= (live) 0))
  (fails (make-r_demo__Counter -1) "negative initial" 'native)
  (check (= (live) 0))
  (fails (make-r_demo__Counter) "Wrong number of arguments" 'wrong-number-of-args)
  (let ((c (make-r_demo__Counter 20)))
    (check (r_demo__Counter? c))
    (check (not (r_demo__Counter? 20)))
    (check (string-prefix? "#<r_demo__Counter " (format #f "~a" c)))
    (check (= (live) 1))
    (check (= (r_demo__Counter-add c 22) 42))
    (check (= (r_demo__Counter-value c) 42))
    (check (and (= (r_demo__Counter-count c) 42) (= (r_demo__Counter-initial c) 20)))
    (check (= (r_demo__Counter-answer) 42))
    (set-r_demo__Counter-count! c 7)
    (check (= (r_demo__Counter-value c) 7))
    (let ((label "世界😀\x00"))
      (set-r_demo__Counter-label! c label)
      (check (string=? (r_demo__Counter-label c) label)))
    ;; Const fields have no setter.
    (check (exported? '(guile_demo) 'r_demo__Counter-initial))
    (check (not (exported? '(guile_demo) 'set-r_demo__Counter-initial!)))
    (fails (set-r_demo__Counter-count! c #t) "expected an exact integer" 'conversion)
    (check (= (r_demo__Counter-count c) 7))
    (fails (r_demo__Counter-add 5 1) "expected a r_demo__Counter" 'conversion)
    (let ((s (make-r_verify__Series)))
      (fails (r_demo__Counter-add s 1) "expected a r_demo__Counter" 'conversion)
      (fails (r_demo__Counter-close! s) "expected a r_demo__Counter" 'conversion)
      (r_verify__Series-close! s))
    (fails (r_demo__Counter-add c) "Wrong number of arguments" 'wrong-number-of-args)
    (r_demo__Counter-close! c)
    (check (= (live) 0))
    (fails (r_demo__Counter-value c) "native object is closed" 'conversion)
    (fails (set-r_demo__Counter-count! c 1) "native object is closed" 'conversion)
    ;; Closing twice is harmless.
    (check (unspecified? (r_demo__Counter-close! c)))
    (check (r_demo__Counter? c)))
  ;; An unreachable object is destroyed by its finalizer. It is created on a
  ;; short-lived thread so no stack slot here keeps it alive.
  (join-thread (call-with-new-thread (lambda () (make-r_demo__Counter 1) #t)))
  (check (eventually (lambda () (= (live) 0))))
  (let ((objects (list (make-r_verify__Series) (make-r_verify__Worklist 2) (make-r_verify__AsyncTask 1 60000 #f))))
    (check (and (= (r_verify__Series-live) 1) (= (r_verify__AsyncTask-live) 1)))
    (r_verify__Series-close! (car objects))
    (r_verify__Worklist-close! (cadr objects))
    (r_verify__AsyncTask-close! (caddr objects))
    (check (and (= (r_verify__Series-live) 0) (= (r_verify__AsyncTask-live) 0) (= (r_verify__AsyncTask-workers) 0))))
  ;; Calls from several Guile threads are serialized.
  (let ((c (make-r_demo__Counter 0)))
    (for-each join-thread
              (map (lambda (i) (call-with-new-thread (lambda () (do ((k 0 (+ k 1))) ((= k 1000)) (r_demo__Counter-add c 1)))))
                   (iota 4)))
    (check (= (r_demo__Counter-value c) 4000))
    (r_demo__Counter-close! c)))

 ((string=? family "features")
  (check (= (v "maximum" 20 42) 42))
  (check (= (v "template_box" 42) 42))
  (check (= (v "variadic_sum" 10 20 12) 42))
  (check (= (v "constant_answer") 42))
  (check (= (v "constrained_sum" 20 22) 42))
  (check (= (v "hierarchy_value" 42) 42))
  (check (v "hierarchy_crosscast"))
  (check (= (v "rosetta_r_c_identity" 42) 42))
  (fails (v "constrained_sum" (- (expt 2 31) 1) 1) "overflow" 'range)
  (fails (make-r_verify__Series 0 -1) "series count" 'index)
  (let ((s (make-r_verify__Series)))
    (check (and (= (r_verify__Series-size s) 2) (= (r_verify__Series-get s) 20) (= (r_verify__Series-scaled_sum s 2) 82)))
    (check (string=? (r_verify__Series-text s) "[20, 21]"))
    (r_verify__Series-set s 1 22)
    (check (= (r_verify__Series-scaled_sum s 1) 42))
    (fails (r_verify__Series-get s 2) "out of range" 'index)
    (fails (r_verify__Series-set s -1 1) "out of range")
    (r_verify__Series-close! s))
  (for-each
   (lambda (order expected)
     (let ((q (make-r_verify__Worklist order)))
       (for-each (lambda (x) (r_verify__Worklist-push q x)) '("a" "z" "m"))
       (check (= (r_verify__Worklist-size q) 3))
       (check (equal? (let* ((a (r_verify__Worklist-pop q)) (b (r_verify__Worklist-pop q)) (c (r_verify__Worklist-pop q)))
                        (list a b c))
                      expected))
       (fails (r_verify__Worklist-pop q) "empty" 'index)
       (r_verify__Worklist-close! q)))
   '(1 2 3 4) '(("m" "z" "a") ("a" "z" "m") ("z" "m" "a") ("a" "m" "z")))
  (fails (make-r_verify__Worklist 0) "unknown worklist order" 'argument)
  (let ((task (make-r_verify__AsyncTask 21 0 #f)))
    (check (and (r_verify__AsyncTask-wait task 2000) (= (r_verify__AsyncTask-result task) 42) (= (r_verify__AsyncTask-result task) 42)))
    (r_verify__AsyncTask-close! task))
  (let ((task (make-r_verify__AsyncTask 1 0 #t)))
    (check (r_verify__AsyncTask-wait task 2000))
    (fails (r_verify__AsyncTask-result task) "async worker failure")
    (r_verify__AsyncTask-close! task))
  (let ((task (make-r_verify__AsyncTask 1 60000 #f)))
    (check (and (not (r_verify__AsyncTask-ready task)) (not (r_verify__AsyncTask-wait task 0))
                (r_verify__AsyncTask-cancel task) (r_verify__AsyncTask-wait task 2000)))
    (fails (r_verify__AsyncTask-result task) "cancelled")
    (r_verify__AsyncTask-close! task))
  (fails (make-r_verify__AsyncTask 1 -1 #f) "delay" 'index)
  (check (= (r_verify__AsyncTask-workers) 0))
  ;; Leave a 60s worker running at exit, bounded by the CTest timeout.
  (make-r_verify__AsyncTask 1 60000 #f))

 ((string=? family "repl")
  (check (= (r_demo__add 20 22) 42))
  (let ((c (make-r_demo__Counter 20)))
    (check (= (r_demo__Counter-add c 22) 42))
    (r_demo__Counter-close! c))
  (let ((s (make-r_verify__Series)))
    (check (= (r_verify__Series-scaled_sum s 2) 82))
    (r_verify__Series-close! s)))
 (else (error "unknown family" family)))

(format #t "Guile ~a: ~a passed, ~a failed\n" family passes failures)
(exit (if (zero? failures) 0 1))
